{
  "$id": "/schemas/3.0.0-rc.3/core/content-rating.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "Content advisory rating using a specified rating system",
  "properties": {
    "rating": {
      "description": "Rating value within the system (e.g., 'TV-PG', 'R', 'explicit')",
      "type": "string"
    },
    "system": {
      "$ref": "/schemas/3.0.0-rc.3/enums/content-rating-system.json",
      "description": "Rating system used"
    }
  },
  "required": [
    "system",
    "rating"
  ],
  "title": "Content Rating",
  "type": "object"
}