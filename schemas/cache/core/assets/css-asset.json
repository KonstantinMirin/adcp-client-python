{
  "$id": "/schemas/3.0.0-rc.3/core/assets/css-asset.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "CSS stylesheet asset",
  "properties": {
    "content": {
      "description": "CSS content",
      "type": "string"
    },
    "media": {
      "description": "CSS media query context (e.g., 'screen', 'print')",
      "type": "string"
    },
    "provenance": {
      "$ref": "/schemas/3.0.0-rc.3/core/provenance.json",
      "description": "Provenance metadata for this asset, overrides manifest-level provenance"
    }
  },
  "required": [
    "content"
  ],
  "title": "CSS Asset",
  "type": "object"
}