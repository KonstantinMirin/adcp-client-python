{
  "$id": "/schemas/3.0.0-rc.3/creative/get-creative-features-response.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Response payload for the get_creative_features task. Returns scored feature values from the governance agent's evaluation of the submitted creative manifest.",
  "oneOf": [
    {
      "description": "Success response",
      "properties": {
        "context": {
          "$ref": "/schemas/3.0.0-rc.3/core/context.json"
        },
        "detail_url": {
          "description": "URL to the vendor's full assessment report. The vendor controls what information is disclosed and access control.",
          "format": "uri",
          "type": "string"
        },
        "ext": {
          "$ref": "/schemas/3.0.0-rc.3/core/ext.json"
        },
        "results": {
          "description": "Feature values for the evaluated creative",
          "items": {
            "$ref": "/schemas/3.0.0-rc.3/creative/creative-feature-result.json"
          },
          "type": "array"
        }
      },
      "required": [
        "results"
      ],
      "type": "object"
    },
    {
      "description": "Error response",
      "properties": {
        "context": {
          "$ref": "/schemas/3.0.0-rc.3/core/context.json"
        },
        "errors": {
          "items": {
            "$ref": "/schemas/3.0.0-rc.3/core/error.json"
          },
          "type": "array"
        },
        "ext": {
          "$ref": "/schemas/3.0.0-rc.3/core/ext.json"
        }
      },
      "required": [
        "errors"
      ],
      "type": "object"
    }
  ],
  "title": "Get Creative Features Response",
  "type": "object"
}