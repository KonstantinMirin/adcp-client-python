#!/bin/sh
# A shell preamble, not a python shebang: the interpreter must be the project's own
# .venv (jsonschema, hypothesis and pydantic live there and nowhere else), and
# PYTHONPATH must carry BOTH roots -- "." for codegen and "src" for adcp. PYTHONPATH=.
# alone resolves adcp from an editable .pth in whatever worktree installed it, which
# silently grades a mix of two trees. Measured; see the bd memory on sibling worktrees.
"""true" 2>/dev/null
exec env PYTHONPATH=.:src "$(dirname "$0")/.venv/bin/python" "$0" "$@"
"""
"""The fast loop: the three numbers in 0.06 s, or one document's report in seconds.

**Why this exists.**  The full suite is the GATE, not the loop, and a lane that runs it to
answer "did my change work" waits 40 minutes for a number it can have instantly.  Two
caches make that true -- ``tests/compiled.py`` holds one compile per population keyed on
the compiler's own source, and ``tests/corpus.py`` holds the accepts draw keyed on the
record -- and this is the one command that reads them.

::

    ./check                          the three numbers over the whole bundle
    ./check core/assets/url-asset.json [...]      those documents' report, with reasons
    ./check --primary                every PRIMARY refusal, grouped by keyword
    ./check --why core/foo.json      the full refusal sentence for one document
    ./check --compare [core/foo.json ...]   §8's COMPARISON over every pair, in a minute

A document argument needs no bundle path: it is relative to ``schemas/cache/3.2``.

**The numbers this prints are the ones a delivery reports**, read the way the directive
requires them: ``emitted`` and ``refused`` with its ``resolved`` split, ``accounted``, and
primary/chained off ``Refusal.kind`` and never off a sentence.  They are never summed.

**``--compare`` is the one reading that was not in the loop**, and it is the expensive
reading here by two orders of magnitude -- 36-53 s against 1.1 s, because it imports the
919-module fresh tree and asks ``harness.compare_schema`` for every pair.  It is a
SEPARATE mode for exactly that reason: ``./check`` with no argument stays the thing a lane
runs between edits.  A minute is nonetheless the loop and not the pole, against the 6-7
hours of the only pass that read this before (``tests/compared.py`` carries the
measurement and the argument that no detection is traded away).
"""

import collections
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "tests"))

BUNDLE = Path("schemas/cache/3.2")


def _out(population: list[str] | None = None):
    from codegen import bundle

    from compiled import compiled

    return compiled(BUNDLE, population or sorted(bundle.portable(BUNDLE)))


def numbers() -> int:
    """The three numbers, which is what a delivery reports."""
    started = time.time()
    out = _out()
    kinds = collections.Counter(
        str(refusal["kind"]).split(".")[-1] for refusal in out.refusals.values()
    )
    resolved = collections.Counter(
        str(refusal["resolved"]).split(".")[-1] for refusal in out.refusals.values()
    )
    facts = sum(len(v) for v in out.approximations.values())
    chained = kinds["chained"]
    print(
        f"emitted {len(out.emitted)} / refused {len(out.refusals)} "
        f"(deferred {resolved['deferred']}, verdict {resolved['verdict']}); "
        f"accounted {len(out.emitted) + resolved['verdict']}"
    )
    print(
        f"kind: verdict {kinds['verdict']}, deferred {kinds['deferred']}, "
        f"chained {chained}  ->  primary {len(out.refusals) - chained}, chained {chained}"
    )
    print(f"approximated {facts} facts in {len(out.approximations)} documents")
    print(f"({time.time() - started:.2f} s)", file=sys.stderr)
    return 0


def primary() -> int:
    """Every primary refusal, grouped by the keyword it reports on.

    Primary is read off ``Refusal.kind``, never off the sentence: a chained refusal's
    detail quotes its target's, so a grep over the text counts one obstruction once per
    quoting document.  That mistake has been made five times in this epic and
    ``refusal.Kind``'s docstring records four of them.
    """
    out = _out()
    rows = [
        (document, refusal)
        for document, refusal in out.refusals.items()
        if str(refusal["kind"]).split(".")[-1] != "chained"
    ]
    by_keyword = collections.defaultdict(list)
    for document, refusal in rows:
        by_keyword[refusal["keyword"]].append((document, refusal))
    print(f"{len(rows)} PRIMARY refusals over {len(by_keyword)} keywords\n")
    for keyword, group in sorted(by_keyword.items(), key=lambda kv: -len(kv[1])):
        print(f"  {keyword}  ({len(group)})")
        for document, refusal in sorted(group):
            kind = str(refusal["kind"]).split(".")[-1]
            print(f"     {kind:9} {document}  at {refusal['pointer'] or '/'}")
    return 0


def why(documents: list[str]) -> int:
    """The full refusal sentence for each named document, or that it emits."""
    out = _out()
    for document in documents:
        refusal = out.refusals.get(document)
        if refusal is None:
            module = out.emitted.get(document)
            print(f"EMITS  {document}  ->  {module}")
            continue
        print(
            f"REFUSED {document}\n"
            f"   kind={str(refusal['kind']).split('.')[-1]} "
            f"resolved={str(refusal['resolved']).split('.')[-1]} "
            f"keyword={refusal['keyword']} pointer={refusal['pointer'] or '/'}\n"
            f"   {refusal['detail']}\n"
        )
    return 0


def compare(documents: list[str]) -> int:
    """§8's comparison over every pair of the fresh tree, grouped two ways.

    The reading, and never a count on its own: the pairing with the pairs whose document
    cannot be read at named apart, the red pairs with their facts BY DIRECTION -- ``added``
    is a model NARROWER than its document and is the direction §2 forbids outright -- then
    the same facts grouped by SHAPE and by DOCUMENT, which are the two axes a row is cut
    along.

    ``tests/test_the_comparison_census.py`` pins what this prints; the derivation is
    ``tests/compared.py`` and both read it, so the gate and the loop cannot disagree about
    what the comparison says.  A document argument lists that document's own red pairs in
    full -- the census is over the WHOLE population either way, because a comparison over
    one document would answer a question nobody asked.
    """
    import compared

    census = compared.census()
    directions = compared.by_direction(census.red)
    print(
        f"paired {census.paired} "
        f"(compared {census.paired - len(census.unreadable)}, "
        f"document unreadable {len(census.unreadable)})"
    )
    print(
        f"red {len(census.red)} pairs in "
        f"{len({name.split('#')[0] for name in census.red})} documents / "
        f"{sum(len(facts) for facts in census.red.values())} facts: "
        f"missing {directions['missing']}, differs {directions['differs']}, "
        f"added {directions['added']}"
    )
    print(
        "outcome: "
        + ", ".join(f"{outcome} {n}" for outcome, n in sorted(census.outcomes.items()))
    )
    # A verdict that carries NO fact -- §8's sixth outcome, a model whose schema cannot be
    # built, a pair whose document states nothing -- is invisible in the three directions
    # above, so it is printed by name here and pinned empty by the census test.
    for name, outcome in sorted(census.verdicts.items()):
        if name not in census.red:
            print(f"  {outcome}  {name}")
    print("\nBY SHAPE  (facts / pairs / documents)")
    for shape, (facts, pairs, docs) in compared.by_shape(census.red).items():
        print(f"  {facts:5} {pairs:5} {docs:5}  {shape}")
    print("\nBY DOCUMENT  (pairs / facts), the ten worst")
    for document, (pairs, facts) in list(compared.by_document(census.red).items())[:10]:
        print(f"  {pairs:5} {facts:5}  {document}")
    for document, raise_ in sorted(census.unreadable.items()):
        print(f"\nUNREADABLE {document}\n   {raise_}")
    for document in documents:
        named = {name: facts for name, facts in census.red.items() if name.split("#")[0] == document}
        print(f"\n{document}: {len(named)} red pairs")
        for name, facts in sorted(named.items()):
            print(f"  {name}")
            for fact in facts:
                print(f"     {fact}")
    print(f"({census.seconds:.1f} s to compare)", file=sys.stderr)
    return 0


def report(documents: list[str]) -> int:
    """Those documents and their closure, the way ``python -m codegen`` reports them.

    A closure and not the whole bundle, because a lane iterating on one document wants
    its answer in seconds and does not need the other 1,050.
    """
    import subprocess

    return subprocess.call(
        [
            sys.executable,
            "-m",
            "codegen",
            "--bundle",
            str(BUNDLE),
            "--tree",
            "/tmp/check-tree",
            *documents,
        ]
    )


def main(argv: list[str]) -> int:
    if not argv:
        return numbers()
    if argv[0] == "--primary":
        return primary()
    if argv[0] == "--why":
        return why(argv[1:])
    if argv[0] == "--compare":
        return compare(argv[1:])
    return report(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
