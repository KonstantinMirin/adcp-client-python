#!/bin/sh
# The same preamble as ``./check``, for the same reason: the interpreter must be the
# project's own .venv, and PYTHONPATH must carry BOTH roots -- "." for codegen and "src"
# for adcp. PYTHONPATH=. alone resolves adcp from an editable .pth in whatever worktree
# installed it, which silently grades a mix of two trees.
"""true" 2>/dev/null
exec env PYTHONPATH=.:src "$(dirname "$0")/.venv/bin/python" "$0" "$@"
"""
"""THE VERIFICATION, over every pair, as one command that leaves a dated artifact.

    ./verify                 grade every pair of the committed tree; write both artifacts
    ./verify --quiet         the counts only

**WHY THIS EXISTS, and it is the defect it closes rather than a convenience.**  The
verification has always been implemented -- ``codegen.harness``'s six checks, driven by
``codegen.__main__.grade`` -- and there has never been a command that ran it over the
WHOLE bundle.  ``python -m codegen`` takes documents as positional arguments, so the only
way to grade everything was to name 1,059 paths; nobody did.  Consequences, measured:

* ``src/adcp/types/verdicts.tsv`` was last written on **2026-11-10** and describes a tree
  two days and twenty commits old, while being quoted as the current state;
* ``tests_emit/test_emit.py::test_every_class_passes_all_three_checks`` -- the pytest gate
  over it -- died on **2026-11-11** when ``harness.Fixtures`` was deleted with the corpus
  apparatus, so all 2,608 of its cases raise ``AttributeError`` in their fixture instead
  of reporting a verdict, and the suite still COLLECTS green because the call is in a
  fixture rather than at import;
* so ``./check``'s three green numbers -- which measure EMISSION, not agreement with the
  document -- were the only screen anybody read, and 321 not-pass rows sat unexamined.

**AND THE TIMING GOES IN THE FILE.**  ``grade`` prints its duration to stderr, so no
artifact could say when it ran or what it cost, and every question about the verification
cost a re-run.  ``verify.json`` carries the duration, the counts per check, every not-pass
row with its cause, and the provenance -- this repository's head and the bundle's path --
so the next question is answered by reading it.

**WHAT IT DOES NOT DO: it does not emit.**  It grades the tree that is COMMITTED, so what
it reports is what the repository ships.  ``./check`` is the emission loop and
``python -m codegen`` is the emitter; running those first is the caller's business, and
keeping them separate is what lets this command's artifact be compared against the tree a
reader has checked out.
"""

import json
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent
SUITE = next(d for d in (ROOT / "tests_emit", ROOT / "tests") if (d / "compiled.py").is_file())
sys.path.insert(0, str(SUITE))

from codegen import patch  # noqa: E402  (the sys.path line above is what makes it resolve)

#: The bundle a run reads: the published one with the build's patch sets applied.  One
#: derivation, shared with ``./check`` and ``tests_emit/fresh.py``, so the three cannot
#: range over different inputs.
BUNDLE = patch.for_build(Path("schemas/cache/3.2"))

#: The committed tree, which is the thing a delivery ships.
TREE = ROOT / "src" / "adcp" / "types" / "_schemas"
PACKAGE = ROOT / "src" / "adcp" / "types"
TABLE = ROOT / "src" / "adcp" / "types" / "verdicts.tsv"
REPORT = ROOT / "src" / "adcp" / "types" / "verify.json"


def _head() -> str:
    """This repository's HEAD, so the artifact says which tree it graded."""
    try:
        done = subprocess.run(
            ["git", "-C", str(ROOT), "rev-parse", "--short", "HEAD"],
            capture_output=True,
            text=True,
            check=False,
        )
        dirty = subprocess.run(
            ["git", "-C", str(ROOT), "status", "--porcelain"],
            capture_output=True,
            text=True,
            check=False,
        )
        return done.stdout.strip() + ("+dirty" if dirty.stdout.strip() else "")
    except OSError:
        return "unknown"


def _read(table: str) -> tuple[list[str], list[dict[str, str]]]:
    """``(header comments, rows)`` from the table ``grade`` just produced.

    Parsed from the string in hand rather than re-read from disk, so the artifact and the
    report cannot describe two different runs.
    """
    lines = table.splitlines()
    comments = [line for line in lines if line.startswith("#")]
    body = [line for line in lines if not line.startswith("#")]
    if not body:
        return comments, []
    names = body[0].split("\t")
    rows = [dict(zip(names, line.split("\t"), strict=False)) for line in body[1:]]
    return comments, rows


def main(argv: list[str]) -> int:
    from codegen.__main__ import grade

    quiet = "--quiet" in argv
    started = time.time()
    table, written = grade(TREE, PACKAGE, BUNDLE)
    seconds = time.time() - started

    TABLE.write_text(table)
    comments, rows = _read(table)

    # **THE COUNTS ARE DERIVED FROM THE ROWS, not parsed out of the header.**  The header
    # is prose the table writes for a reader; a count taken from it would be a second
    # reading of the same rows, free to disagree with the first.
    checks = ("accepts", "refuses", "dump", "widening", "undeclared", "admits")
    per_check: dict[str, dict[str, int]] = {}
    for check in checks:
        tally = {"pass": 0, "fail": 0, "absent": 0}
        for row in rows:
            cell = row.get(check, "")
            for state in tally:
                if cell.startswith(f"{check}={state}"):
                    tally[state] += 1
        per_check[check] = tally

    not_pass = [row for row in rows if not row.get("verdict", "").startswith("verdict=pass")]
    causes: dict[str, int] = {}
    for row in not_pass:
        cause = row["verdict"].replace("verdict=", "")
        causes[cause] = causes.get(cause, 0) + 1

    REPORT.write_text(
        json.dumps(
            {
                "graded": written,
                "pass": written - len(not_pass),
                "not_pass": len(not_pass),
                "seconds": round(seconds, 1),
                "seconds_per_pair": round(seconds / written, 4) if written else None,
                "per_check": per_check,
                "causes": dict(sorted(causes.items(), key=lambda kv: -kv[1])),
                "provenance": {
                    "head": _head(),
                    "bundle": str(BUNDLE),
                    "tree": str(TREE.relative_to(ROOT)),
                },
                # Every not-pass row, so the next question about one is answered by reading
                # this file.  The note is what the harness itself wrote about the pair --
                # the document's own reason -- and it is kept whole rather than truncated.
                "not_pass_rows": [
                    {
                        "document": row.get("document"),
                        "pointer": row.get("pointer"),
                        "class": row.get("class"),
                        "verdict": row.get("verdict"),
                        **{c: row.get(c) for c in checks},
                        "note": row.get("note"),
                    }
                    for row in not_pass
                ],
            },
            indent=1,
            sort_keys=True,
        )
    )

    if not quiet:
        for line in comments:
            print(line)
    print(f"graded {written} pairs: {written - len(not_pass)} pass, {len(not_pass)} not pass")
    for cause, count in sorted(causes.items(), key=lambda kv: -kv[1]):
        print(f"   {count:5d}  {cause}")
    print(f"\n   {TABLE.relative_to(ROOT)}\n   {REPORT.relative_to(ROOT)}")
    print(f"({seconds:.1f} s, {seconds / max(written, 1) * 1000:.0f} ms per pair)", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
