{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "reporting_revision_id"
              ]
            },
            {
              "required": [
                "supersedes_reporting_revision_id"
              ]
            },
            {
              "required": [
                "finality"
              ]
            }
          ]
        },
        "required": [
          "reporting_adjustment_id",
          "adjusts_reporting_revision_id"
        ]
      },
      "if": {
        "properties": {
          "change_kind": {
            "const": "revision_published"
          }
        },
        "required": [
          "change_kind"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "reporting_adjustment_id"
              ]
            },
            {
              "required": [
                "adjusts_reporting_revision_id"
              ]
            }
          ]
        },
        "required": [
          "reporting_revision_id",
          "finality"
        ]
      }
    }
  ],
  "description": "Optional account-anchored invalidation fired for every newly committed reporting revision or post-official adjustment, whether or not health changes. Valid in every reporting tier. Receivers repair from their own durable changes_after checkpoint through get_reporting_status; this event is never the source of truth.",
  "properties": {
    "account_id": {
      "minLength": 1,
      "type": "string",
      "x-entity": "account"
    },
    "adjusts_reporting_revision_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
      "type": "string",
      "x-entity": "reporting_revision"
    },
    "change_kind": {
      "enum": [
        "revision_published",
        "adjustment_published"
      ],
      "type": "string"
    },
    "ext": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Extension object for platform-specific, vendor-namespaced parameters. Extensions are always optional and must be namespaced under a vendor/platform key (e.g., ext.gam, ext.roku). Used for custom capabilities, partner-specific configuration, and features being proposed for standardization.",
      "title": "Extension Object",
      "type": "object"
    },
    "finality": {
      "enum": [
        "official",
        "snapshot"
      ]
    },
    "fired_at": {
      "format": "date-time",
      "type": "string"
    },
    "idempotency_key": {
      "description": "Random per distinct fire and stable across transport retries, scoped to the authenticated sender.",
      "maxLength": 255,
      "minLength": 16,
      "pattern": "^[A-Za-z0-9_.:-]{16,255}$",
      "type": "string"
    },
    "notification_id": {
      "description": "Stable per committed ledger record; re-emissions reuse it.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
      "type": "string"
    },
    "notification_type": {
      "const": "reporting.ledger_changed",
      "type": "string"
    },
    "reporting_adjustment_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
      "type": "string",
      "x-entity": "reporting_adjustment"
    },
    "reporting_revision_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
      "type": "string",
      "x-entity": "reporting_revision"
    },
    "subscriber_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
      "type": "string"
    },
    "supersedes_reporting_revision_id": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
      "type": "string",
      "x-entity": "reporting_revision"
    }
  },
  "required": [
    "idempotency_key",
    "notification_id",
    "notification_type",
    "fired_at",
    "subscriber_id",
    "account_id",
    "change_kind"
  ],
  "title": "Reporting Ledger Changed Webhook",
  "type": "object",
  "x-adcp-validation": {
    "logical_record": "One destination-independent revision or adjustment produces one logical account event even when it fans out through multiple obligations or delivery configurations. Receivers use changes_after to resolve the affected obligations and deduplicate by the immutable record identity."
  },
  "x-status": "experimental"
}
