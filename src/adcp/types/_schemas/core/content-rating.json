{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "Content advisory rating using a specified rating system",
  "properties": {
    "rating": {
      "description": "Rating value within the system (e.g., 'TV-PG', 'R', 'explicit')",
      "type": "string"
    },
    "system": {
      "enum": [
        "acb",
        "csa",
        "fsk",
        "bbfc",
        "esrb",
        "mpaa",
        "pegi",
        "chvrs",
        "custom",
        "podcast",
        "tv_parental"
      ]
    }
  },
  "required": [
    "system",
    "rating"
  ],
  "title": "Content Rating",
  "type": "object"
}
