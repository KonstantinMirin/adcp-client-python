{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "An operating-system or platform dimension for a ForecastPoint row. Variant of ForecastPoint dimensions; see forecast-point-dimensions.json for dispatch rules.",
  "properties": {
    "device_platform": {
      "enum": [
        "ios",
        "tvos",
        "linux",
        "macos",
        "tizen",
        "webos",
        "android",
        "fire_os",
        "roku_os",
        "unknown",
        "windows",
        "chromeos"
      ]
    },
    "kind": {
      "const": "device_platform",
      "description": "Dimension family discriminator.",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "device_platform"
  ],
  "title": "Device Platform Forecast Dimension",
  "type": "object"
}
