      "description": "Period and availability SLA this offering can honor. For example, PT1H with snapshot finality explicitly advertises hourly provisional snapshots; a separate P1D official offering advertises daily finalized reporting.",
      "maxProperties": 7,
      "properties": {
        "alignment": {
          "enum": [
            "utc",
            "billing_cycle",
            "source_timezone",
            "account_timezone"
          ]
        },
        "delivery_sla": {
          "pattern": "^P(?=\\d|T)(?=.*\\d)(?:\\d+Y)?(?:\\d+M)?(?:\\d+D)?(?:T(?=\\d)(?:\\d+H)?(?:\\d+M)?(?:\\d+S)?)?$",
          "type": "string"
        },
        "period_anchor": {
          "format": "date-time",
          "type": "string"
        },
        "period_anchor_policy": {
          "enum": [
            "fixed",
            "configurable"
          ]
        },
        "period_duration": {
          "pattern": "^P(?=.*[1-9])(?=\\d|T)(?:\\d+Y)?(?:\\d+M)?(?:\\d+D)?(?:T(?=\\d)(?:\\d+H)?(?:\\d+M)?(?:\\d+S)?)?$",
          "type": "string"
        },
        "period_timezone": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "period_timezone_policy": {
          "enum": [
            "fixed",
            "account_resolved"
          ]
        }
      },
      "required": [
        "alignment",
        "delivery_sla",
        "period_duration"
      ],
      "title": "Reporting Schedule Offering",
      "type": "object",
      "x-adcp-validation": {
        "iana_timezone": "Every advertised fixed period_timezone MUST be a recognized IANA Time Zone Database zone name or link, including UTC. Unknown identifiers and numeric UTC offsets are invalid.",
        "installed_schedule_match": "period_duration, alignment, and delivery_sla MUST equal the installed configuration. For fixed billing_cycle offerings, period_anchor and period_timezone MUST also equal it. For configurable billing_cycle offerings, the installed configuration supplies both values. A fixed source_timezone offering supplies period_timezone; an account_resolved source_timezone offering requires the seller to resolve and echo period_timezone before the configuration becomes ready. utc and account_timezone use the normative origins in reporting-schedule.json, so even multi-unit durations have one independently derivable phase.",
        "source_compatibility": "The resolved schedule MUST be compatible with the pinned report definition calendar. A seller MUST NOT advertise or accept a schedule merely because it can query the source eventually; it must be able to produce the exact promised periods natively or through lossless finer-grained re-bucketing."
      },
      "x-status": "experimental"
    },
    "supported_finality": {
      "description": "Finality classes available under this exact report definition, schedule, and delivery method. snapshot is an explicit provisional capability, not inferred from poll frequency. Use separate atomic offerings when snapshot and official schedules or methods differ.",
      "items": {
        "enum": [
          "official",
          "snapshot"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
