    "report_definition_id": {
      "description": "Immutable semantic definition for metric, grain, attribution, action-report-time, timezone/calendar, source/API mapping, and restatement/finality policy. Configurations and revisions MUST echo this exact value.",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]{1,255}$",
      "type": "string",
      "x-entity": "reporting_definition"
    },
    "report_definition_sha256": {
      "description": "Digest of the exact report-definition bytes. SDKs verify this before parsing and cache by digest.",
      "pattern": "^[A-Fa-f0-9]{64}$",
      "type": "string"
    },
    "report_definition_uri": {
      "description": "Retrievable immutable reporting-report-definition.json document on the authenticated seller/provider or AdCP-registry origin.",
      "format": "uri",
      "pattern": "^https://(?![^/]*@)(?!localhost(?:[:/]|$))(?!\\[)(?!\\d+(?:\\.\\d+){3}(?::|/|$))(?:[A-Za-z0-9-]+\\.)+[A-Za-z]{2,}(?::\\d+)?(?:/|$)",
      "type": "string"
    },
    "reporting_profile": {
      "additionalProperties": false,
      "description": "Machine-readable semantic and validation contract for delivered rows. The canonicalization_* fields describe the external-materialization canonical-digest contract and are required only for offerings under the reconciled_billing tier; Core and managed-delivery offerings omit those fields but every Core revision still carries the fixed RFC 8785/JCS revision-binding digest.",
      "properties": {
        "canonicalization_contract_version": {
          "const": "1.0",
          "type": "string"
        },
        "canonicalization_id": {
          "description": "Rules for stable logical row ordering, value encoding, nulls, and schema used by canonical_content_digest.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "canonicalization_media_type": {
          "const": "application/vnd.adcp.reporting-canonicalization+json",
          "type": "string"
        },
        "canonicalization_sha256": {
          "description": "Digest of the exact canonicalization contract identified by canonicalization_id.",
          "pattern": "^[A-Fa-f0-9]{64}$",
          "type": "string"
        },
        "canonicalization_uri": {
          "description": "Retrievable exact canonicalization contract on the authenticated seller/provider or AdCP-registry origin. SDKs apply the same bounded, redirect-free SSRF controls as schema_uri and verify canonicalization_sha256 before use.",
          "format": "uri",
          "pattern": "^https://(?![^/]*@)(?!localhost(?:[:/]|$))(?!\\[)(?!\\d+(?:\\.\\d+){3}(?::|/|$))(?:[A-Za-z0-9-]+\\.)+[A-Za-z]{2,}(?::\\d+)?(?:/|$)",
          "type": "string"
        },
        "grain": {
          "description": "Stable description of what one logical row represents.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$",
          "type": "string"
        },
        "primary_keys": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Reporting Primary Key",
            "type": "string",
            "x-adcp-model-context-inline": true
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "schema_dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema",
          "description": "Closed SDK-bundled dialect. The SDK never resolves a metaschema over the network, and the fetched document's $schema MUST equal this value.",
          "type": "string"
        },
        "schema_ref_policy": {
          "const": "local_fragment_only",
          "description": "The fetched schema is a self-contained bundle. Every $ref is a local # fragment; remote and relative-document dependencies are forbidden.",
          "type": "string"
        },
        "schema_sha256": {
          "description": "Digest of the exact schema bytes. SDKs verify this before parsing and cache by digest.",
          "pattern": "^[A-Fa-f0-9]{64}$",
          "type": "string"
        },
        "schema_uri": {
          "description": "Authenticated seller/provider or AdCP-registry HTTPS origin only; never an IP literal, userinfo URL, redirect target, or mutable validation authority.",
          "format": "uri",
          "pattern": "^https://(?![^/]*@)(?!localhost(?:[:/]|$))(?!\\[)(?!\\d+(?:\\.\\d+){3}(?::|/|$))(?:[A-Za-z0-9-]+\\.)+[A-Za-z]{2,}(?::\\d+)?(?:/|$)",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "schema_uri",
        "schema_sha256",
        "schema_dialect",
        "schema_ref_policy",
        "grain",
        "primary_keys"
      ],
      "type": "object"
    },
