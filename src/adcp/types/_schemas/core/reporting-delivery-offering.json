{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "feed_purpose": {
            "const": "billing"
          }
        },
        "required": [
          "feed_purpose"
        ]
      },
      "then": {
        "properties": {
          "reconciliation_mode": {
            "const": "consumer_receipt"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reconciliation_mode": {
            "const": "consumer_receipt"
          }
        },
        "required": [
          "reconciliation_mode"
        ]
      },
      "then": {
        "properties": {
          "reporting_profile": {
            "required": [
              "canonicalization_id",
              "canonicalization_contract_version",
              "canonicalization_media_type",
              "canonicalization_uri",
              "canonicalization_sha256"
            ]
          }
        },
        "required": [
          "method"
        ]
      }
    }
  ],
  "definitions": {
    "ReportingDeliveryPattern": {
      "enum": [
        "file_transfer",
        "dataset_share",
        "warehouse_materialization"
      ],
      "title": "Reporting Delivery Pattern",
      "type": "string"
    },
    "ReportingFeedPurpose": {
      "description": "Operational use of an independently scheduled and reconciled feed. pacing is the fast snapshot path; billing requires official revisions and consumer reconciliation. Event-level exposure is intentionally deferred until a privacy and authorization contract exists.",
      "enum": [
        "pacing",
        "analytics",
        "billing"
      ],
      "title": "Reporting Feed Purpose",
      "type": "string",
      "x-adcp-model-context-inline": true
    }
  },
  "description": "One atomic combination a seller can honor. Buyers MUST NOT form a cross-product from separate capability arrays; each installed configuration selects one offering_id and values within that offering. A Core API-delivered offering requires no Managed external-materialization canonicalization code or contract, but every resulting revision still carries the fixed RFC 8785/JCS revision-binding canonicalization and digest.",
  "properties": {
    "feed_purpose": {
      "enum": [
        "pacing",
        "billing",
        "analytics"
      ]
    },
    "method": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "pattern"
            ]
          },
          "then": {
            "required": [
              "provider"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "pattern": {
                "const": "file_transfer"
              }
            },
            "required": [
              "pattern"
            ]
          },
          "then": {
            "required": [
              "format"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "pattern": {
                "const": "dataset_share"
              }
            },
            "required": [
              "pattern"
            ]
          },
          "then": {
            "required": [
              "access_mode"
            ]
          }
        }
      ],
      "description": "Managed delivery method for this offering. Omit for a Core (API-delivered) offering: rows flow through existing get_media_buy_delivery and reporting_webhook transports and no destination is involved. Present only when the seller advertises managed_delivery.",
      "properties": {
        "access_mode": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "type": "string"
        },
        "destination_modes": {
          "items": {
            "enum": [
              "provision",
              "existing"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "format": {
          "enum": [
            "jsonl",
            "csv",
            "parquet",
            "avro",
            "orc"
          ],
          "type": "string"
        },
        "orchestration": {
          "enum": [
            "consumer_managed",
            "producer_managed"
          ]
        },
        "pattern": {
          "enum": [
            "dataset_share",
            "file_transfer",
            "warehouse_materialization"
          ]
        },
        "producer_identity": {
          "additionalProperties": false,
          "dependencies": {
            "cloud": [
              "region"
            ],
            "region": [
              "cloud"
            ]
          },
          "description": "Seller principal a buyer grants access to for this exact buyer-hosted destination offering.",
          "properties": {
            "cloud": {
              "enum": [
                "aws",
                "gcp",
                "azure"
              ]
            },
            "identity": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "provider": {
              "additionalProperties": false,
              "properties": {
                "domain": {
                  "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
                  "type": "string"
                }
              },
              "required": [
                "domain"
              ],
              "type": "object"
            },
            "region": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "provider",
            "identity"
          ],
          "type": "object"
        },
        "provider": {
          "additionalProperties": false,
          "properties": {
            "domain": {
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
              "type": "string"
            }
          },
          "required": [
            "domain"
          ],
          "type": "object"
        },
        "reader_compatibility": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Reporting Reader Compatibility Item",
            "type": "string",
            "x-adcp-model-context-inline": true
          },
          "type": "array",
          "uniqueItems": true
        },
        "transport": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "type": "string"
        }
