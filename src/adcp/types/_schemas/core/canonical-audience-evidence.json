{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "relationship": {
            "const": "composition"
          }
        },
        "required": [
          "relationship"
        ]
      },
      "then": {
        "properties": {
          "unit": {
            "const": "fraction"
          },
          "value": {
            "maximum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "relationship": {
            "const": "index"
          }
        },
        "required": [
          "relationship"
        ]
      },
      "then": {
        "properties": {
          "unit": {
            "const": "ratio"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "relationship": {
            "const": "reach_estimate"
          }
        },
        "required": [
          "relationship"
        ]
      },
      "then": {
        "properties": {
          "unit": {
            "const": "count"
          },
          "value": {
            "type": "integer"
          }
        }
      }
    }
  ],
  "definitions": {
    "Shared0": {
      "minLength": 1,
      "type": "string"
    },
    "Shared1": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "Shared2": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "A URL whose scheme is https. Extracted unchanged from the 46 sites that stated it inline; see adcontextprotocol/adcp#8525. This is the shape adcontextprotocol/adcp#8398 asks the other seven uri patterns to reduce to.",
      "format": "uri",
      "pattern": "^https://",
      "title": "HTTPS URL",
      "type": "string"
    },
    "Shared3": {
      "type": "string"
    },
    "Shared4": {
      "const": "age"
    },
    "Shared5": {
      "type": "number"
    },
    "Shared6": {
      "type": "boolean"
    },
    "Shared7": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "description": "Compact immutable audience-evidence snapshot for product discovery. Provider identity is a BrandKey; credential and brand-asset graphs are resolved separately.",
  "properties": {
    "attestation_digests": {
      "description": "Portable-attestation reference digests available through the evidence provider; credential bodies are not inlined into product discovery.",
      "items": {
        "$ref": "#/definitions/Shared1"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "audience": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "dimension": {
                "$ref": "#/definitions/Shared4"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "then": {
            "properties": {
              "range": {
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "max": {
                    "$ref": "#/definitions/Shared7"
                  },
                  "min": {
                    "$ref": "#/definitions/Shared7"
                  }
                },
                "type": "object"
              },
              "value": {
                "oneOf": [
                  {
                    "$ref": "#/definitions/Shared7"
                  },
                  {
                    "items": {
                      "$ref": "#/definitions/Shared7"
                    },
                    "minItems": 1,
                    "type": "array",
                    "uniqueItems": true
                  }
                ]
              }
            }
          }
        }
      ],
      "anyOf": [
        {
          "not": {
            "required": [
              "range"
            ]
          },
          "required": [
            "value"
          ]
        },
        {
          "not": {
            "required": [
              "value"
            ]
          },
          "required": [
            "range"
          ]
        }
      ],
      "description": "A machine-comparable audience dimension and value or numeric range used in population-level audience evidence. The built-in `age` dimension uses completed years: scalar and set values and range bounds MUST be non-negative integers, and a range's min MUST be less than or equal to its max. Provider-defined dimensions SHOULD use an HTTPS URI and SHOULD identify their taxonomy so two similarly named dimensions are not assumed equivalent.",
      "properties": {
        "dimension": {
          "anyOf": [
            {
              "$ref": "#/definitions/Shared4"
            },
            {
              "format": "uri",
              "pattern": "^https://"
            }
          ],
          "description": "Canonical dimension name or HTTPS URI. AdCP 3.2 defines `age`; other values remain provider- or taxonomy-scoped.",
          "type": "string"
        },
        "label": {
          "description": "Human-readable display label; never the comparison key.",
          "type": "string"
        },
        "range": {
          "additionalProperties": false,
          "description": "Inclusive numeric interval. For dimension `age`, values are completed years and MUST be non-negative integers, and min MUST be less than or equal to max. JSON Schema enforces the age value and bound types; implementations enforce the relational min <= max constraint.",
          "minProperties": 1,
          "properties": {
            "max": {
              "$ref": "#/definitions/Shared5"
            },
            "min": {
              "$ref": "#/definitions/Shared5"
            }
          },
          "type": "object"
        },
        "taxonomy": {
          "additionalProperties": false,
          "description": "External system that defines the dimension or value. Taxonomy metadata is descriptive and does not create exact demographic targeting semantics.",
          "properties": {
            "system": {
              "$ref": "#/definitions/Shared2"
            },
            "value_id": {
              "$ref": "#/definitions/Shared0"
            },
            "version": {
              "$ref": "#/definitions/Shared0"
            }
          },
          "required": [
            "system"
          ],
          "type": "object"
        },
        "value": {
          "description": "Scalar or set value for the dimension.",
          "oneOf": [
            {
              "$ref": "#/definitions/Shared3"
            },
            {
              "$ref": "#/definitions/Shared5"
            },
            {
              "$ref": "#/definitions/Shared6"
            },
            {
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/definitions/Shared3"
                  },
                  {
                    "$ref": "#/definitions/Shared5"
                  },
                  {
                    "$ref": "#/definitions/Shared6"
                  }
                ]
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          ]
        }
      },
      "required": [
        "dimension"
      ],
      "title": "Audience Characteristic",
      "type": "object"
    },
    "baseline": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/definitions/Shared3"
        },
        "population_id": {
          "$ref": "#/definitions/Shared0"
        },
        "system": {
          "$ref": "#/definitions/Shared2"
        },
        "version": {
          "$ref": "#/definitions/Shared0"
        }
      },
      "required": [
        "system",
        "population_id",
        "version"
      ],
      "type": "object"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "content_digest": {
      "$ref": "#/definitions/Shared1"
    },
    "evidence_id": {
      "minLength": 1,
      "type": "string",
      "x-entity": "audience_evidence"
    },
    "evidence_type": {
      "enum": [
        "measured",
        "forecast",
        "seller_declared"
      ],
      "type": "string"
    },
    "ext": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": true,
      "description": "Extension object for platform-specific, vendor-namespaced parameters. Extensions are always optional and must be namespaced under a vendor/platform key (e.g., ext.gam, ext.roku). Used for custom capabilities, partner-specific configuration, and features being proposed for standardization.",
      "title": "Extension Object",
      "type": "object"
    },
    "last_updated": {
      "format": "date-time",
      "type": "string"
    },
    "measurement_window": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": true,
      "description": "A date range with inclusive start and end dates (ISO 8601 calendar dates). Used for billing periods, flight dates, and other calendar-day boundaries.",
      "properties": {
        "end": {
          "description": "End date (inclusive), ISO 8601",
          "format": "date",
          "type": "string"
        },
        "start": {
          "description": "Start date (inclusive), ISO 8601",
          "format": "date",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Date Range",
      "type": "object"
    },
    "methodology": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "How a population-level audience-evidence estimate was produced. This vocabulary is intentionally separate from signal-definition methodology: `projected` describes expansion of a sample or panel to a reference population and does not become a user-level signal-membership method.",
      "enum": [
        "observed",
        "declared",
        "derived",
        "inferred",
        "modeled",
        "projected"
      ],
      "title": "Audience Evidence Methodology",
      "type": "string"
    },
    "methodology_url": {
      "$ref": "#/definitions/Shared2"
    },
    "provider": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "description": "Stable brand identity used to resolve the canonical brand manifest, optionally qualified by the countries of a commercial advertiser entity. The manifest URL is derived from domain; callers do not send brand assets or per-call brand overrides. Countries do not target delivery.",
      "properties": {
        "brand_id": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "description": "Brand within a house-of-brands manifest. Omit for a single-brand domain.",
          "examples": [
            "tide",
            "cheerios",
            "air_jordan",
            "nike",
            "pampers"
          ],
          "pattern": "^[a-z0-9_]+$",
          "title": "Brand ID",
          "type": "string",
          "x-entity": "advertiser_brand"
        },
        "countries": {
          "description": "Canonical set of ISO 3166-1 alpha-2 countries for this advertiser identity. Omit when the identity is global or the house does not split the brand geographically. Array order is not meaningful; producers MUST sort codes lexicographically before computing keys or signatures. This qualifies account and proposal identity and is not delivery targeting.",
          "items": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "description": "ISO 3166-1 alpha-2 country code. Extracted unchanged from the 65 sites that stated it inline; see adcontextprotocol/adcp#8525.",
            "pattern": "^[A-Z]{2}$",
            "title": "Country Code",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "domain": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "description": "Domain that hosts /.well-known/brand.json or is registered for the brand.",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
          "title": "Domain Name",
          "type": "string"
        }
      },
      "required": [
        "domain"
      ],
      "title": "Brand Key",
      "type": "object"
    },
    "relationship": {
      "enum": [
        "composition",
        "index",
        "reach_estimate"
      ],
      "type": "string"
    },
    "resolution_method": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "How subjects were resolved when producing a signal or population-level evidence estimate.",
      "enum": [
        "deterministic_id",
        "probabilistic_device",
        "browser",
        "geographic",
        "content_signal",
        "mixed"
      ],
      "title": "Audience Resolution Method",
      "type": "string"
    },
    "sample_size": {
      "minimum": 1,
      "type": "integer"
    },
    "snapshot_id": {
      "minLength": 1,
      "type": "string",
      "x-entity": "audience_evidence_snapshot"
    },
    "subject_type": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "The kind of subject characterized by audience data or population-level evidence.",
      "enum": [
        "individual",
        "household",
        "business",
        "contextual",
        "none"
      ],
      "title": "Audience Subject Type",
      "type": "string"
    },
    "unit": {
      "enum": [
        "fraction",
        "ratio",
        "count"
      ],
      "type": "string"
    },
    "value": {
      "minimum": 0,
      "type": "number"
    },
    "version": {
      "$ref": "#/definitions/Shared0"
    }
  },
  "required": [
    "evidence_id",
    "snapshot_id",
    "version",
    "content_digest",
    "audience",
    "relationship",
    "value",
    "unit",
    "baseline",
    "evidence_type",
    "methodology",
    "subject_type",
    "provider",
    "measurement_window",
    "last_updated"
  ],
  "title": "Canonical Audience Evidence",
  "type": "object"
}
