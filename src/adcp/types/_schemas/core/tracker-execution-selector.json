{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "One exact first-class manifest tracker selector in a seller production execution contract. AdCP 3.2 supports pixel_tracker, vast_tracker, and daast_tracker only; URL-slot selectors are not part of this union.",
  "discriminator": {
    "propertyName": "asset_type"
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "required": [
                "custom_event_name"
              ]
            }
          },
          "if": {
            "properties": {
              "event": {
                "const": "custom"
              }
            },
            "required": [
              "event"
            ]
          },
          "then": {
            "required": [
              "custom_event_name"
            ]
          }
        }
      ],
      "properties": {
        "asset_type": {
          "const": "pixel_tracker",
          "type": "string"
        },
        "custom_event_name": {
          "description": "Required only when event is custom.",
          "minLength": 1,
          "type": "string"
        },
        "event": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "description": "Closed AdCP event vocabulary for renderer-fired pixel trackers. Impression and viewability values through `viewable_video_50` map to IAB OpenRTB Native event tracker types 1-4. `audible_video_complete` is an AdCP-defined first-class event, not an assigned IAB Native event type; Native reserves 500+ for exchange-specific use. `click` represents Native click trackers and `custom` is the explicit adopter-defined extension point.",
          "enum": [
            "impression",
            "viewable_mrc_50",
            "viewable_mrc_100",
            "viewable_video_50",
            "audible_video_complete",
            "click",
            "custom"
          ],
          "title": "Pixel Tracking Event",
          "type": "string"
        },
        "execution_actor": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "description": "Actor responsible for initiating a buyer-supplied tracker under a seller-authored execution contract. This v1 vocabulary is intentionally narrower than the macro resolver actor vocabulary.",
          "enum": [
            "seller",
            "request_executor"
          ],
          "title": "Tracker Execution Actor",
          "type": "string"
        },
        "firing_paths": {
          "description": "Complete set of permitted initiation environments. Exactly one path is selected for each logical event occurrence.",
          "items": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "description": "Environment in which the responsible actor initiates a tracker. A selector may permit both values, but exactly one path is used for each logical event occurrence.",
            "enum": [
              "client",
              "server"
            ],
            "title": "Tracker Firing Path",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "method": {
          "const": "img",
          "description": "AdCP 3.2 execution contracts cover image-pixel initiation only; JavaScript response evaluation is outside this contract version.",
          "type": "string"
        },
        "selector_id": {
          "description": "Stable identifier unique within the materialized execution contract.",
          "minLength": 1,
          "type": "string",
          "x-entity": "tracker_execution_selector"
        }
      },
      "required": [
        "selector_id",
        "asset_type",
        "event",
        "method",
        "execution_actor",
        "firing_paths"
      ],
      "type": "object"
    },
