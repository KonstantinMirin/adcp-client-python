{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Shared0": {
      "description": "Stable identifier unique within the materialized execution contract.",
      "minLength": 1,
      "type": "string",
      "x-entity": "tracker_execution_selector"
    },
    "Shared1": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Actor responsible for initiating a buyer-supplied tracker under a seller-authored execution contract. This v1 vocabulary is intentionally narrower than the macro resolver actor vocabulary.",
      "enum": [
        "seller",
        "request_executor"
      ],
      "title": "Tracker Execution Actor",
      "type": "string"
    },
    "Shared10": {
      "required": [
        "custom_event_name"
      ]
    },
    "Shared11": {
      "anyOf": [
        {
          "not": {
            "required": [
              "target"
            ]
          }
        },
        {
          "properties": {
            "target": {
              "const": "linear"
            }
          },
          "required": [
            "target"
          ]
        }
      ]
    },
    "Shared12": {
      "properties": {
        "target": {
          "const": "companion"
        }
      },
      "required": [
        "target"
      ]
    },
    "Shared13": {
      "required": [
        "offset"
      ]
    },
    "Shared14": {
      "not": {
        "$ref": "#/definitions/Shared13"
      }
    },
    "Shared15": {
      "const": "creativeView"
    },
    "Shared16": {
      "const": "progress"
    },
    "Shared2": {
      "description": "Complete set of permitted initiation environments. Exactly one path is selected for each logical event occurrence.",
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "description": "Environment in which the responsible actor initiates a tracker. A selector may permit both values, but exactly one path is used for each logical event occurrence.",
        "enum": [
          "client",
          "server"
        ],
        "title": "Tracker Firing Path",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "Shared3": {
      "items": {
        "$comment": "VAST 4.3 ships no XSD of its own: IAB's `vast_4.2.xsd` remains the authoritative schema for 4.3 documents, so a validator MUST NOT reject a tag declaring `version=\"4.3\"` for want of a 4.3 schema. VAST 4.4 is deliberately absent because `vast_4.4.xsd` is annotated 'DRAFT for working group discussion' and is not a published specification; add it once IAB publishes it, not before. This file is the single source of truth for the roster, per the Enum Consolidation rule in docs/spec-guidelines.md, and other schemas `$ref` it rather than restating the list.",
        "$schema": "http://json-schema.org/draft-07/schema#",
        "description": "Supported VAST (Video Ad Serving Template) specification versions. Covers every version published by IAB Tech Lab, through VAST 4.3 (released December 2022). The value mirrors the `version` attribute a VAST document declares on its root element.",
        "enum": [
          "2.0",
          "3.0",
          "4.0",
          "4.1",
          "4.2",
          "4.3"
        ],
        "title": "VAST Version",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "Shared4": {
      "enum": [
        "creativeView",
        "loaded",
        "start",
        "firstQuartile",
        "midpoint",
        "thirdQuartile",
        "complete",
        "mute",
        "unmute",
        "pause",
        "resume",
        "rewind",
        "skip",
        "playerExpand",
        "playerCollapse",
        "fullscreen",
        "exitFullscreen",
        "progress",
        "acceptInvitation",
        "adExpand",
        "adCollapse",
        "minimize",
        "overlayViewDuration",
        "otherAdInteraction",
        "interactiveStart",
        "close",
        "closeLinear"
      ],
      "type": "string"
    },
    "Shared5": {
      "default": "linear",
      "enum": [
        "linear",
        "non_linear",
        "companion"
      ],
      "type": "string"
    },
    "Shared6": {
      "pattern": "^(\\d{2}:[0-5]\\d:[0-5]\\d(\\.\\d{3})?|(100|\\d{1,2})%)$",
      "type": "string"
    },
    "Shared7": {
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "description": "Supported DAAST (Digital Audio Ad Serving Template) specification versions",
        "enum": [
          "1.0",
          "1.1"
        ],
        "title": "DAAST Version",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "Shared8": {
      "enum": [
        "creativeView",
        "start",
        "firstQuartile",
        "midpoint",
        "thirdQuartile",
        "complete",
        "mute",
        "unmute",
        "pause",
        "resume",
        "rewind",
        "skip",
        "progress",
        "close"
      ],
      "type": "string"
    },
    "Shared9": {
      "default": "linear",
      "enum": [
        "linear",
        "companion"
      ],
      "type": "string"
    }
  },
  "description": "One exact first-class manifest tracker selector in a seller production execution contract. AdCP 3.2 supports pixel_tracker, vast_tracker, and daast_tracker only; URL-slot selectors are not part of this union.",
  "discriminator": {
    "propertyName": "asset_type"
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "$ref": "#/definitions/Shared10"
            }
          },
          "if": {
            "properties": {
              "event": {
                "const": "custom"
              }
            },
            "required": [
              "event"
            ]
          },
          "then": {
            "$ref": "#/definitions/Shared10"
          }
        }
      ],
      "properties": {
        "asset_type": {
          "const": "pixel_tracker",
          "type": "string"
        },
        "custom_event_name": {
          "description": "Required only when event is custom.",
          "minLength": 1,
          "type": "string"
        },
        "event": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "description": "Closed AdCP event vocabulary for renderer-fired pixel trackers. Impression and viewability values through `viewable_video_50` map to IAB OpenRTB Native event tracker types 1-4. `audible_video_complete` is an AdCP-defined first-class event, not an assigned IAB Native event type; Native reserves 500+ for exchange-specific use. `click` represents Native click trackers and `custom` is the explicit adopter-defined extension point.",
          "enum": [
            "impression",
            "viewable_mrc_50",
            "viewable_mrc_100",
            "viewable_video_50",
            "audible_video_complete",
            "click",
            "custom"
          ],
          "title": "Pixel Tracking Event",
          "type": "string"
        },
        "execution_actor": {
          "$ref": "#/definitions/Shared1"
        },
        "firing_paths": {
          "$ref": "#/definitions/Shared2"
        },
        "method": {
          "const": "img",
          "description": "AdCP 3.2 execution contracts cover image-pixel initiation only; JavaScript response evaluation is outside this contract version.",
          "type": "string"
        },
        "selector_id": {
          "$ref": "#/definitions/Shared0"
        }
      },
      "required": [
        "selector_id",
        "asset_type",
        "event",
        "method",
        "execution_actor",
        "firing_paths"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "allOf": [
        {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "allOf": [
            {
              "if": {
                "$ref": "#/definitions/Shared11"
              },
              "then": {
                "properties": {
                  "vast_event": {
                    "enum": [
                      "creativeView",
                      "loaded",
                      "start",
                      "firstQuartile",
                      "midpoint",
                      "thirdQuartile",
                      "complete",
                      "mute",
                      "unmute",
                      "pause",
                      "resume",
                      "rewind",
                      "skip",
                      "playerExpand",
                      "playerCollapse",
                      "fullscreen",
                      "exitFullscreen",
                      "progress",
                      "otherAdInteraction",
                      "interactiveStart",
                      "closeLinear"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "target": {
                    "const": "non_linear"
                  }
                },
                "required": [
                  "target"
                ]
              },
              "then": {
                "properties": {
                  "vast_event": {
                    "enum": [
                      "creativeView",
                      "acceptInvitation",
                      "adExpand",
                      "adCollapse",
                      "minimize",
                      "overlayViewDuration",
                      "otherAdInteraction",
                      "close"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "$ref": "#/definitions/Shared12"
              },
              "then": {
                "properties": {
                  "vast_event": {
                    "$ref": "#/definitions/Shared15"
                  }
                }
              }
            },
            {
              "else": {
                "$ref": "#/definitions/Shared14"
              },
              "if": {
                "properties": {
                  "vast_event": {
                    "$ref": "#/definitions/Shared16"
                  }
                },
                "required": [
                  "vast_event"
                ]
              },
              "then": {
                "$ref": "#/definitions/Shared13"
              }
            },
            {
              "if": {
                "properties": {
                  "vast_event": {
                    "enum": [
                      "skip",
                      "progress"
                    ]
                  }
                },
                "required": [
                  "vast_event"
                ]
              },
              "then": {
                "properties": {
                  "vast_versions": {
                    "items": {
                      "enum": [
                        "3.0",
                        "4.0",
                        "4.1",
                        "4.2",
                        "4.3"
                      ]
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "vast_event": {
                    "const": "fullscreen"
                  }
                },
                "required": [
                  "vast_event"
                ]
              },
              "then": {
                "properties": {
                  "vast_versions": {
                    "items": {
                      "enum": [
                        "2.0",
                        "3.0"
                      ]
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "vast_event": {
                    "const": "exitFullscreen"
                  }
                },
                "required": [
                  "vast_event"
                ]
              },
              "then": {
                "properties": {
                  "vast_versions": {
                    "items": {
                      "const": "3.0"
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "vast_event": {
                    "enum": [
                      "playerExpand",
                      "playerCollapse",
                      "adExpand",
                      "adCollapse",
                      "minimize",
                      "overlayViewDuration",
                      "otherAdInteraction"
                    ]
                  }
                },
                "required": [
                  "vast_event"
                ]
              },
              "then": {
                "properties": {
                  "vast_versions": {
                    "items": {
                      "enum": [
                        "4.0",
                        "4.1",
                        "4.2",
                        "4.3"
                      ]
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "vast_event": {
                    "const": "loaded"
                  }
                },
                "required": [
                  "vast_event"
                ]
              },
              "then": {
                "properties": {
                  "vast_versions": {
                    "items": {
                      "enum": [
                        "4.1",
                        "4.2",
                        "4.3"
                      ]
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "vast_event": {
                    "const": "interactiveStart"
                  }
                },
                "required": [
                  "vast_event"
                ]
              },
              "then": {
                "properties": {
                  "vast_versions": {
                    "items": {
                      "enum": [
                        "4.2",
                        "4.3"
                      ]
                    }
                  }
                }
              }
            },
            {
              "$comment": "VAST 4.0 omitted closeLinear; VAST 4.1 restored it from VAST 3.0. The 4.0 gap is intentional.",
              "if": {
                "properties": {
                  "vast_event": {
                    "const": "closeLinear"
                  }
                },
                "required": [
                  "vast_event"
                ]
              },
              "then": {
                "properties": {
                  "vast_versions": {
                    "items": {
                      "enum": [
                        "3.0",
                        "4.1",
                        "4.2",
                        "4.3"
                      ]
                    }
                  }
                }
              }
            }
          ],
          "definitions": {
            "vast_event": {
              "$ref": "#/definitions/Shared4"
            },
            "vast_offset": {
              "$ref": "#/definitions/Shared6"
            },
            "vast_target": {
              "$ref": "#/definitions/Shared5"
            },
            "vast_versions": {
              "$ref": "#/definitions/Shared3"
            }
          },
          "description": "Shared VAST TrackingEvents constraints used by tracker assets and production execution selectors. The target/event matrix is closed, progress alone carries offset, and selector version arrays may contain only versions in which the event exists.",
          "properties": {
            "offset": {
              "$ref": "#/definitions/Shared6"
            },
            "target": {
              "$ref": "#/definitions/Shared5"
            },
            "vast_event": {
              "$ref": "#/definitions/Shared4"
            },
            "vast_versions": {
              "$ref": "#/definitions/Shared3"
            }
          },
          "title": "VAST Tracker Constraints",
          "type": "object"
        }
      ],
      "properties": {
        "asset_type": {
          "const": "vast_tracker",
          "type": "string"
        },
        "execution_actor": {
          "$ref": "#/definitions/Shared1"
        },
        "firing_paths": {
          "$ref": "#/definitions/Shared2"
        },
        "offset": {
          "$ref": "#/definitions/Shared6"
        },
        "selector_id": {
          "$ref": "#/definitions/Shared0"
        },
        "target": {
          "$ref": "#/definitions/Shared5"
        },
        "vast_event": {
          "$ref": "#/definitions/Shared4"
        },
        "vast_versions": {
          "$ref": "#/definitions/Shared3"
        }
      },
      "required": [
        "selector_id",
        "asset_type",
        "vast_versions",
        "vast_event",
        "target",
        "execution_actor",
        "firing_paths"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "allOf": [
        {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "allOf": [
            {
              "if": {
                "$ref": "#/definitions/Shared11"
              },
              "then": {
                "properties": {
                  "daast_event": {
                    "enum": [
                      "creativeView",
                      "start",
                      "firstQuartile",
                      "midpoint",
                      "thirdQuartile",
                      "complete",
                      "mute",
                      "unmute",
                      "pause",
                      "resume",
                      "rewind",
                      "skip",
                      "progress"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "$ref": "#/definitions/Shared12"
              },
              "then": {
                "properties": {
                  "daast_event": {
                    "$ref": "#/definitions/Shared15"
                  }
                }
              }
            },
            {
              "else": {
                "$ref": "#/definitions/Shared14"
              },
              "if": {
                "properties": {
                  "daast_event": {
                    "$ref": "#/definitions/Shared16"
                  }
                },
                "required": [
                  "daast_event"
                ]
              },
              "then": {
                "$ref": "#/definitions/Shared13"
              }
            }
          ],
          "definitions": {
            "daast_event": {
              "$ref": "#/definitions/Shared8"
            },
            "daast_offset": {
              "$ref": "#/definitions/Shared6"
            },
            "daast_target": {
              "$ref": "#/definitions/Shared9"
            },
            "daast_versions": {
              "$ref": "#/definitions/Shared7"
            }
          },
          "description": "Shared DAAST tracker vocabulary and execution-selector constraints. The legacy asset vocabulary retains AdCP's historical close extension, while the closed standards selector matrix excludes it. Progress alone carries offset in selectors.",
          "properties": {
            "daast_event": {
              "$ref": "#/definitions/Shared8"
            },
            "daast_versions": {
              "$ref": "#/definitions/Shared7"
            },
            "offset": {
              "$ref": "#/definitions/Shared6"
            },
            "target": {
              "$ref": "#/definitions/Shared9"
            }
          },
          "title": "DAAST Tracker Constraints",
          "type": "object"
        }
      ],
      "properties": {
        "asset_type": {
          "const": "daast_tracker",
          "type": "string"
        },
        "daast_event": {
          "$ref": "#/definitions/Shared8"
        },
        "daast_versions": {
          "$ref": "#/definitions/Shared7"
        },
        "execution_actor": {
          "$ref": "#/definitions/Shared1"
        },
        "firing_paths": {
          "$ref": "#/definitions/Shared2"
        },
        "offset": {
          "$ref": "#/definitions/Shared6"
        },
        "selector_id": {
          "$ref": "#/definitions/Shared0"
        },
        "target": {
          "$ref": "#/definitions/Shared9"
        }
      },
      "required": [
        "selector_id",
        "asset_type",
        "daast_versions",
        "daast_event",
        "target",
        "execution_actor",
        "firing_paths"
      ],
      "type": "object"
    }
  ],
  "title": "Tracker Execution Selector"
}
