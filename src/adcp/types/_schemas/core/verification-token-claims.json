{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "definitions": {
    "VerificationTokenGradingProfile": {
      "enum": [
        "legacy",
        "spec"
      ],
      "type": "string"
    },
    "VerificationTokenMode": {
      "enum": [
        "spec",
        "live"
      ],
      "type": "string"
    }
  },
  "description": "Claims carried by an AgenticAdvertising.org EdDSA verification token. The registry API remains authoritative for real-time badge status. Tokens issued before grading-profile selection may omit grading_profile and are interpreted as Legacy.",
  "properties": {
    "adcp_version": {
      "pattern": "^[1-9][0-9]*\\.[0-9]+$",
      "type": "string"
    },
    "agent_url": {
      "format": "uri",
      "type": "string"
    },
    "aud": {
      "const": "aao-verification",
      "type": "string"
    },
    "exp": {
      "minimum": 0,
      "type": "integer"
    },
    "first_failing_spec_at": {
      "description": "Start of the current Strict Spec failure episode. Omitted when no Strict Spec failure clock is active. The registry remains authoritative for real-time status.",
      "format": "date-time",
      "type": "string"
    },
    "grading_profile": {
      "enum": [
        "spec",
        "legacy"
      ]
    },
    "iat": {
      "minimum": 0,
      "type": "integer"
    },
    "iss": {
      "const": "https://aao.org",
      "type": "string"
    },
    "jti": {
      "minLength": 1,
      "type": "string"
    },
    "protocol_version": {
      "type": "string"
    },
    "role": {
      "enum": [
        "media-buy",
        "creative",
        "signals",
        "governance",
        "brand",
        "sponsored-intelligence"
      ],
      "type": "string"
    },
    "sub": {
      "format": "uri",
      "type": "string"
    },
    "verification_modes": {
      "items": {
        "enum": [
          "live",
          "spec"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "verified_specialisms": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "iss",
    "sub",
    "aud",
    "jti",
    "iat",
    "exp",
    "agent_url",
    "role",
    "verified_specialisms",
    "verification_modes"
  ],
  "title": "AgenticAdvertising.org Verification Token Claims",
  "type": "object"
}
