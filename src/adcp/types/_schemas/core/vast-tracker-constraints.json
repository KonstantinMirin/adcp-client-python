{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "not": {
              "required": [
                "target"
              ]
            }
          },
          {
            "properties": {
              "target": {
                "const": "linear"
              }
            },
            "required": [
              "target"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "vast_event": {
            "enum": [
              "creativeView",
              "loaded",
              "start",
              "firstQuartile",
              "midpoint",
              "thirdQuartile",
              "complete",
              "mute",
              "unmute",
              "pause",
              "resume",
              "rewind",
              "skip",
              "playerExpand",
              "playerCollapse",
              "fullscreen",
              "exitFullscreen",
              "progress",
              "otherAdInteraction",
              "interactiveStart",
              "closeLinear"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "const": "non_linear"
          }
        },
        "required": [
          "target"
        ]
      },
      "then": {
        "properties": {
          "vast_event": {
            "enum": [
              "creativeView",
              "acceptInvitation",
              "adExpand",
              "adCollapse",
              "minimize",
              "overlayViewDuration",
              "otherAdInteraction",
              "close"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "const": "companion"
          }
        },
        "required": [
          "target"
        ]
      },
      "then": {
        "properties": {
          "vast_event": {
            "const": "creativeView"
          }
        }
      }
    },
    {
      "else": {
        "not": {
          "required": [
            "offset"
          ]
        }
      },
      "if": {
        "properties": {
          "vast_event": {
            "const": "progress"
          }
        },
        "required": [
          "vast_event"
        ]
      },
      "then": {
        "required": [
          "offset"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "vast_event": {
            "enum": [
              "skip",
              "progress"
            ]
          }
        },
        "required": [
          "vast_event"
        ]
      },
      "then": {
        "properties": {
          "vast_versions": {
            "items": {
              "enum": [
                "3.0",
                "4.0",
                "4.1",
                "4.2",
                "4.3"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "vast_event": {
            "const": "fullscreen"
          }
        },
        "required": [
          "vast_event"
        ]
      },
      "then": {
        "properties": {
          "vast_versions": {
            "items": {
              "enum": [
                "2.0",
                "3.0"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "vast_event": {
            "const": "exitFullscreen"
          }
        },
        "required": [
          "vast_event"
        ]
      },
      "then": {
        "properties": {
          "vast_versions": {
            "items": {
              "const": "3.0"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "vast_event": {
            "enum": [
              "playerExpand",
              "playerCollapse",
              "adExpand",
              "adCollapse",
              "minimize",
              "overlayViewDuration",
              "otherAdInteraction"
            ]
          }
        },
        "required": [
          "vast_event"
        ]
      },
      "then": {
        "properties": {
          "vast_versions": {
            "items": {
              "enum": [
                "4.0",
                "4.1",
                "4.2",
                "4.3"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "vast_event": {
            "const": "loaded"
          }
        },
        "required": [
          "vast_event"
        ]
      },
      "then": {
        "properties": {
          "vast_versions": {
            "items": {
              "enum": [
                "4.1",
                "4.2",
                "4.3"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "vast_event": {
            "const": "interactiveStart"
          }
        },
        "required": [
          "vast_event"
        ]
      },
      "then": {
        "properties": {
          "vast_versions": {
            "items": {
              "enum": [
                "4.2",
                "4.3"
              ]
            }
          }
        }
      }
    },
    {
      "$comment": "VAST 4.0 omitted closeLinear; VAST 4.1 restored it from VAST 3.0. The 4.0 gap is intentional.",
      "if": {
        "properties": {
          "vast_event": {
            "const": "closeLinear"
          }
        },
        "required": [
          "vast_event"
        ]
      },
      "then": {
        "properties": {
          "vast_versions": {
            "items": {
              "enum": [
                "3.0",
                "4.1",
                "4.2",
                "4.3"
              ]
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "vast_event": {
      "enum": [
        "creativeView",
        "loaded",
        "start",
        "firstQuartile",
        "midpoint",
        "thirdQuartile",
        "complete",
        "mute",
        "unmute",
        "pause",
        "resume",
        "rewind",
        "skip",
        "playerExpand",
        "playerCollapse",
        "fullscreen",
        "exitFullscreen",
        "progress",
        "acceptInvitation",
        "adExpand",
        "adCollapse",
        "minimize",
        "overlayViewDuration",
        "otherAdInteraction",
        "interactiveStart",
        "close",
        "closeLinear"
      ],
      "type": "string"
    },
    "vast_offset": {
      "pattern": "^(\\d{2}:[0-5]\\d:[0-5]\\d(\\.\\d{3})?|(100|\\d{1,2})%)$",
      "type": "string"
    },
    "vast_target": {
      "default": "linear",
      "enum": [
        "linear",
        "non_linear",
        "companion"
      ],
      "type": "string"
    },
    "vast_versions": {
      "items": {
        "$comment": "VAST 4.3 ships no XSD of its own: IAB's `vast_4.2.xsd` remains the authoritative schema for 4.3 documents, so a validator MUST NOT reject a tag declaring `version=\"4.3\"` for want of a 4.3 schema. VAST 4.4 is deliberately absent because `vast_4.4.xsd` is annotated 'DRAFT for working group discussion' and is not a published specification; add it once IAB publishes it, not before. This file is the single source of truth for the roster, per the Enum Consolidation rule in docs/spec-guidelines.md, and other schemas `$ref` it rather than restating the list.",
        "$schema": "http://json-schema.org/draft-07/schema#",
        "description": "Supported VAST (Video Ad Serving Template) specification versions. Covers every version published by IAB Tech Lab, through VAST 4.3 (released December 2022). The value mirrors the `version` attribute a VAST document declares on its root element.",
        "enum": [
          "2.0",
          "3.0",
          "4.0",
          "4.1",
          "4.2",
          "4.3"
        ],
        "title": "VAST Version",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "description": "Shared VAST TrackingEvents constraints used by tracker assets and production execution selectors. The target/event matrix is closed, progress alone carries offset, and selector version arrays may contain only versions in which the event exists.",
  "properties": {
    "offset": {
      "$ref": "#/definitions/vast_offset"
    },
    "target": {
      "$ref": "#/definitions/vast_target"
    },
    "vast_event": {
      "$ref": "#/definitions/vast_event"
    },
    "vast_versions": {
      "$ref": "#/definitions/vast_versions"
    }
  },
  "title": "VAST Tracker Constraints",
  "type": "object"
}
