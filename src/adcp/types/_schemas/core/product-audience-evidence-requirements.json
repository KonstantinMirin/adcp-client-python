{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "independent_attestation_required": {
            "const": true
          }
        },
        "required": [
          "independent_attestation_required"
        ]
      },
      "then": {
        "required": [
          "accepted_attestation_issuers"
        ]
      }
    }
  ],
  "definitions": {
    "Shared0": {
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "description": "How a population-level audience-evidence estimate was produced. This vocabulary is intentionally separate from signal-definition methodology: `projected` describes expansion of a sample or panel to a reference population and does not become a user-level signal-membership method.",
        "enum": [
          "observed",
          "declared",
          "derived",
          "inferred",
          "modeled",
          "projected"
        ],
        "title": "Audience Evidence Methodology",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "Shared1": {
      "items": {
        "$ref": "#/definitions/Shared4"
      },
      "minItems": 1,
      "type": "array"
    },
    "Shared2": {
      "default": false,
      "type": "boolean"
    },
    "Shared3": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": true,
      "description": "Extension object for platform-specific, vendor-namespaced parameters. Extensions are always optional and must be namespaced under a vendor/platform key (e.g., ext.gam, ext.roku). Used for custom capabilities, partner-specific configuration, and features being proposed for standardization.",
      "title": "Extension Object",
      "type": "object"
    },
    "Shared4": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "description": "Stable brand identity used to resolve the canonical brand manifest, optionally qualified by the countries of a commercial advertiser entity. The manifest URL is derived from domain; callers do not send brand assets or per-call brand overrides. Countries do not target delivery.",
      "properties": {
        "brand_id": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "description": "Brand within a house-of-brands manifest. Omit for a single-brand domain.",
          "examples": [
            "tide",
            "cheerios",
            "air_jordan",
            "nike",
            "pampers"
          ],
          "pattern": "^[a-z0-9_]+$",
          "title": "Brand ID",
          "type": "string",
          "x-entity": "advertiser_brand"
        },
        "countries": {
          "description": "Canonical set of ISO 3166-1 alpha-2 countries for this advertiser identity. Omit when the identity is global or the house does not split the brand geographically. Array order is not meaningful; producers MUST sort codes lexicographically before computing keys or signatures. This qualifies account and proposal identity and is not delivery targeting.",
          "items": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "description": "ISO 3166-1 alpha-2 country code. Extracted unchanged from the 65 sites that stated it inline; see adcontextprotocol/adcp#8525.",
            "pattern": "^[A-Z]{2}$",
            "title": "Country Code",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "domain": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "description": "Domain that hosts /.well-known/brand.json or is registered for the brand.",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
          "title": "Domain Name",
          "type": "string"
        }
      },
      "required": [
        "domain"
      ],
      "title": "Brand Key",
      "type": "object"
    }
  },
  "description": "Buyer-authored evidence policy for compact product discovery. Organization selectors are stable keys and never carry brand assets or content provenance.",
  "properties": {
    "accepted_attestation_claim_types": {
      "items": {
        "format": "uri",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "accepted_attestation_issuers": {
      "items": {
        "discriminator": {
          "propertyName": "type"
        },
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "brand": {
                "$ref": "#/definitions/Shared4"
              },
              "ext": {
                "$ref": "#/definitions/Shared3"
              },
              "type": {
                "const": "brand",
                "type": "string"
              }
            },
            "required": [
              "type",
              "brand"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "agent_url": {
                "format": "uri",
                "pattern": "^https://[^/?#@]+(?:/[^?#]*)?(?:\\?[^#]*)?$",
                "type": "string"
              },
              "ext": {
                "$ref": "#/definitions/Shared3"
              },
              "type": {
                "const": "agent",
                "type": "string"
              }
            },
            "required": [
              "type",
              "agent_url"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "ext": {
                "$ref": "#/definitions/Shared3"
              },
              "origin": {
                "format": "uri",
                "pattern": "^https://[^/?#@]+$",
                "type": "string"
              },
              "type": {
                "const": "origin",
                "type": "string"
              }
            },
            "required": [
              "type",
              "origin"
            ],
            "type": "object"
          }
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "accepted_evidence_types": {
      "items": {
        "enum": [
          "measured",
          "forecast",
          "seller_declared"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "accepted_methodologies": {
      "$ref": "#/definitions/Shared0"
    },
    "accepted_providers": {
      "$ref": "#/definitions/Shared1"
    },
    "accepted_resolution_methods": {
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "description": "How subjects were resolved when producing a signal or population-level evidence estimate.",
        "enum": [
          "deterministic_id",
          "probabilistic_device",
          "browser",
          "geographic",
          "content_signal",
          "mixed"
        ],
        "title": "Audience Resolution Method",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "accepted_subject_types": {
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "description": "The kind of subject characterized by audience data or population-level evidence.",
        "enum": [
          "individual",
          "household",
          "business",
          "contextual",
          "none"
        ],
        "title": "Audience Subject Type",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_presence": {
      "enum": [
        "required",
        "when_available"
      ],
      "type": "string"
    },
    "excluded_methodologies": {
      "$ref": "#/definitions/Shared0"
    },
    "excluded_providers": {
      "$ref": "#/definitions/Shared1"
    },
    "ext": {
      "$ref": "#/definitions/Shared3"
    },
    "independent_attestation_required": {
      "$ref": "#/definitions/Shared2"
    },
    "maximum_age": {
      "allOf": [
        {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "additionalProperties": false,
          "description": "A time duration expressed as an interval and unit. Used for frequency cap windows, attribution windows, reach optimization windows, time budgets, and other time-based settings. When unit is 'campaign', interval must be 1 \u2014 the window spans the full campaign flight.",
          "properties": {
            "interval": {
              "description": "Number of time units. Must be 1 when unit is 'campaign'.",
              "minimum": 1,
              "type": "integer"
            },
            "unit": {
              "description": "Time unit. 'seconds' for sub-minute precision. 'campaign' spans the full campaign flight.",
              "enum": [
                "seconds",
                "minutes",
                "hours",
                "days",
                "campaign"
              ],
              "type": "string"
            }
          },
          "required": [
            "interval",
            "unit"
          ],
          "title": "Duration",
          "type": "object"
        },
        {
          "properties": {
            "unit": {
              "enum": [
                "seconds",
                "minutes",
                "hours",
                "days"
              ]
            }
          }
        }
      ]
    },
    "methodology_documentation_required": {
      "$ref": "#/definitions/Shared2"
    },
    "minimum_confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "requirement_mode": {
      "enum": [
        "required",
        "preferred"
      ],
      "type": "string"
    }
  },
  "required": [
    "requirement_mode",
    "evidence_presence"
  ],
  "title": "Product Audience Evidence Requirements",
  "type": "object"
}
