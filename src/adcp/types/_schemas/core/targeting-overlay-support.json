{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "definitions": {
    "Shared0": {
      "const": true,
      "type": "boolean"
    },
    "Shared1": {
      "anyOf": [
        {
          "$ref": "#/definitions/supported"
        },
        {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "additionalProperties": false,
          "description": "Country- and value-aware support for selecting canonical ISO 3166-2 subdivisions. all_values is exhaustive for the values active in the seller's support snapshot when the declaration is issued; it does not automatically include values introduced by a later catalog revision. values is an exact finite subset. In seller-wide capabilities, each declared value is individually supported within the response scope, but the declaration does not promise that values are jointly composable or available through the same execution route or account. In Product.overlay_support, the declared values form the binding set of executable targeting permissions for that Product, subject to its declared limits; support does not itself guarantee inventory for every selection.",
          "properties": {
            "as_of": {
              "description": "Optional date on which the seller last validated this support declaration.",
              "format": "date",
              "type": "string"
            },
            "catalog_version": {
              "description": "Optional opaque ISO subdivision catalog or seller-mapping version that identifies the support snapshot. It is provenance, not part of subdivision identity.",
              "minLength": 1,
              "type": "string"
            },
            "countries": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "all_values": {
                        "const": true,
                        "description": "Every protocol-valid ISO 3166-2 subdivision active in this declaration's support snapshot is selectable. Values introduced by a later catalog revision are not included automatically.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "all_values"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "values": {
                        "description": "Exact finite selectable subset of ISO 3166-2 identifiers for this country.",
                        "items": {
                          "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$",
                          "type": "string"
                        },
                        "minItems": 1,
                        "type": "array",
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "values"
                    ],
                    "type": "object"
                  }
                ]
              },
              "description": "Selectable ISO subdivision values keyed by ISO 3166-1 alpha-2 country.",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/definitions/Shared5"
              },
              "type": "object"
            },
            "ext": {
              "$ref": "#/definitions/Shared3"
            },
            "max_packages": {
              "description": "Optional maximum number of independently region-targeted packages created from this configured product.",
              "minimum": 1,
              "type": "integer"
            },
            "max_values_per_package": {
              "description": "Optional maximum number of region values selectable on one package.",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "countries"
          ],
          "title": "Geographic Region Support",
          "type": "object",
          "x-adcp-validation": {
            "spec": "docs/media-buy/advanced-topics/targeting.mdx#geo_regions",
            "verifier_constraints": {
              "country_prefix_matches_map_key": {
                "map_field": "countries",
                "values_field": "values"
              }
            }
          }
        }
      ]
    },
    "Shared10": {
      "const": true
    },
    "Shared11": {
      "items": {
        "$ref": "#/definitions/Shared4"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "Shared12": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "description": "Exact supported intervals for one duration unit, declared as either an exhaustive preset list or an inclusive integer range. The two forms are mutually exclusive.",
      "if": {
        "properties": {
          "unit": {
            "const": "campaign"
          }
        },
        "required": [
          "unit"
        ]
      },
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "minimum_interval"
                ]
              },
              {
                "required": [
                  "maximum_interval"
                ]
              }
            ]
          },
          "required": [
            "allowed_intervals"
          ]
        },
        {
          "not": {
            "required": [
              "allowed_intervals"
            ]
          },
          "required": [
            "minimum_interval",
            "maximum_interval"
          ]
        }
      ],
      "properties": {
        "allowed_intervals": {
          "$ref": "#/definitions/Shared11"
        },
        "ext": {
          "$ref": "#/definitions/Shared3"
        },
        "maximum_interval": {
          "$ref": "#/definitions/Shared4"
        },
        "minimum_interval": {
          "$ref": "#/definitions/Shared4"
        },
        "unit": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "description": "A duration unit supported for a frequency-cap window or suppression period.",
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "days",
            "campaign"
          ],
          "title": "Frequency Cap Duration Unit",
          "type": "string"
        }
      },
      "required": [
        "unit"
      ],
      "then": {
        "properties": {
          "allowed_intervals": {
            "items": {
              "$ref": "#/definitions/Shared13"
            }
          },
          "maximum_interval": {
            "$ref": "#/definitions/Shared13"
          },
          "minimum_interval": {
            "$ref": "#/definitions/Shared13"
          }
        }
      },
      "title": "Frequency Cap Interval Constraints",
      "type": "object",
      "x-adcp-hoist": true,
      "x-adcp-validation": {
        "ordered_bounds": "minimum_interval MUST be less than or equal to maximum_interval."
      }
    },
    "Shared13": {
      "const": 1
    },
    "Shared2": {
      "anyOf": [
        {
          "$ref": "#/definitions/supported"
        },
        {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "allOf": [
            {
              "$schema": "http://json-schema.org/draft-07/schema#",
              "additionalProperties": {
                "items": {
                  "enum": [
                    "postal_code",
                    "custom"
                  ]
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "description": "Declares supported postal area systems. Native support is keyed by ISO 3166-1 alpha-2 country with arrays of country-local postal systems. Deprecated country-fused boolean aliases may be included during migration.",
              "properties": {
                "AT": {
                  "$ref": "#/definitions/Shared8"
                },
                "AU": {
                  "items": {
                    "const": "postcode"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "BR": {
                  "items": {
                    "const": "cep"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "CA": {
                  "items": {
                    "enum": [
                      "fsa",
                      "full"
                    ]
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "CH": {
                  "$ref": "#/definitions/Shared8"
                },
                "DE": {
                  "$ref": "#/definitions/Shared8"
                },
                "FR": {
                  "items": {
                    "const": "code_postal"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "GB": {
                  "items": {
                    "enum": [
                      "outward",
                      "full"
                    ]
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "IN": {
                  "items": {
                    "const": "pin"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "US": {
                  "items": {
                    "enum": [
                      "zip",
                      "zip_plus_four"
                    ]
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "ZA": {
                  "items": {
                    "const": "postal_code"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "at_plz": {
                  "$ref": "#/definitions/Shared9"
                },
                "au_postcode": {
                  "$ref": "#/definitions/Shared9"
                },
                "ca_fsa": {
                  "$ref": "#/definitions/Shared9"
                },
                "ca_full": {
                  "$ref": "#/definitions/Shared9"
                },
                "ch_plz": {
                  "$ref": "#/definitions/Shared9"
                },
                "de_plz": {
                  "$ref": "#/definitions/Shared9"
                },
                "fr_code_postal": {
                  "$ref": "#/definitions/Shared9"
                },
                "gb_full": {
                  "$ref": "#/definitions/Shared9"
                },
                "gb_outward": {
                  "$ref": "#/definitions/Shared9"
                },
                "us_zip": {
                  "$ref": "#/definitions/Shared9"
                },
                "us_zip_plus_four": {
                  "$ref": "#/definitions/Shared9"
                }
              },
              "propertyNames": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/Shared5"
                  },
                  {
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "deprecated": true,
                    "description": "Deprecated country-fused postal code systems for geographic targeting. Prefer postal-system with an explicit ISO 3166-1 alpha-2 country on postal area objects.",
                    "enum": [
                      "us_zip",
                      "us_zip_plus_four",
                      "gb_outward",
                      "gb_full",
                      "ca_fsa",
                      "ca_full",
                      "de_plz",
                      "fr_code_postal",
                      "au_postcode",
                      "ch_plz",
                      "at_plz"
                    ],
                    "title": "Country-Fused Postal Code System",
                    "type": "string"
                  }
                ]
              },
              "title": "Postal Area Support",
              "type": "object"
            },
            {
              "minProperties": 1,
              "properties": {
                "at_plz": {
                  "$ref": "#/definitions/Shared10"
                },
                "au_postcode": {
                  "$ref": "#/definitions/Shared10"
                },
                "ca_fsa": {
                  "$ref": "#/definitions/Shared10"
                },
                "ca_full": {
                  "$ref": "#/definitions/Shared10"
                },
                "ch_plz": {
                  "$ref": "#/definitions/Shared10"
                },
                "de_plz": {
                  "$ref": "#/definitions/Shared10"
                },
                "fr_code_postal": {
                  "$ref": "#/definitions/Shared10"
                },
                "gb_full": {
                  "$ref": "#/definitions/Shared10"
                },
                "gb_outward": {
                  "$ref": "#/definitions/Shared10"
                },
                "us_zip": {
                  "$ref": "#/definitions/Shared10"
                },
                "us_zip_plus_four": {
                  "$ref": "#/definitions/Shared10"
                }
              },
              "type": "object"
            }
          ],
          "description": "Non-vacuous postal capability used for hard targeting requirements and product overlay support. At least one native system array or true-valued deprecated alias is required. The general seller-capabilities postal schema remains permissive for backward compatibility, but an empty or false-only map cannot satisfy a hard discovery requirement.",
          "title": "Positive Postal Area Support"
        }
      ]
    },
    "Shared3": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": true,
      "description": "Extension object for platform-specific, vendor-namespaced parameters. Extensions are always optional and must be namespaced under a vendor/platform key (e.g., ext.gam, ext.roku). Used for custom capabilities, partner-specific configuration, and features being proposed for standardization.",
      "title": "Extension Object",
      "type": "object"
    },
    "Shared4": {
      "minimum": 1,
      "type": "integer"
    },
    "Shared5": {
      "pattern": "^[A-Z]{2}$"
    },
    "Shared6": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "A URL whose scheme is https. Extracted unchanged from the 46 sites that stated it inline; see adcontextprotocol/adcp#8525. This is the shape adcontextprotocol/adcp#8398 asks the other seven uri patterns to reduce to.",
      "format": "uri",
      "pattern": "^https://",
      "title": "HTTPS URL",
      "type": "string"
    },
    "Shared7": {
      "required": [
        "iana_timezones"
      ]
    },
    "Shared8": {
      "items": {
        "const": "plz"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "Shared9": {
      "deprecated": true,
      "type": "boolean"
    },
    "browserSupport": {
      "anyOf": [
        {
          "$ref": "#/definitions/supported"
        },
        {
          "additionalProperties": false,
          "description": "Canonical browser families that may be selected on packages later. This is executable targeting capability, not a guarantee of inventory for every family.",
          "properties": {
            "ext": {
              "$ref": "#/definitions/Shared3"
            },
            "families": {
              "items": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "description": "Portable browser families for targeting the impression delivery and rendering environment, not a post-click landing-page browser. Values identify browser families, not versions or seller-native browser IDs, and MUST NOT be inferred solely from operating system, device, web/mobile-web inventory, or placement. android_webview means an impression reliably classified as rendering in Android WebView. other means a seller-recognized browser family that is not explicitly enumerated; unknown means the seller cannot classify the browser into a recognized family.",
                "enum": [
                  "chrome",
                  "safari",
                  "firefox",
                  "edge",
                  "opera",
                  "samsung_internet",
                  "android_webview",
                  "other",
                  "unknown"
                ],
                "title": "Browser Family",
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "families"
          ],
          "type": "object"
        }
      ]
    },
    "countrySupport": {
      "anyOf": [
        {
          "$ref": "#/definitions/supported"
        },
        {
          "additionalProperties": false,
          "description": "Binding support for protocol-valid ISO 3166-1 alpha-2 country values, subject to the declared per-package cardinality limit. This object does not enumerate or restrict individual country codes.",
          "properties": {
            "ext": {
              "$ref": "#/definitions/Shared3"
            },
            "max_values_per_package": {
              "description": "Maximum number of country values accepted in this targeting field on one package.",
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "max_values_per_package"
          ],
          "type": "object"
        }
      ]
    },
    "daypartSupport": {
      "anyOf": [
        {
          "const": true,
          "description": "Backward-compatible declaration of inventory_local daypart support. Use the structured form to opt in to concrete IANA timezone execution.",
          "type": "boolean"
        },
        {
          "additionalProperties": false,
          "allOf": [
            {
              "else": {
                "not": {
                  "$ref": "#/definitions/Shared7"
                }
              },
              "if": {
                "properties": {
                  "timezone_modes": {
                    "contains": {
                      "const": "iana"
                    }
                  }
                },
                "required": [
                  "timezone_modes"
                ]
              },
              "then": {
                "$ref": "#/definitions/Shared7"
              }
            }
          ],
          "description": "Binding timezone modes this product can apply to package-level daypart targeting. 'inventory_local' covers the default seller-assigned local clock for each inventory unit. 'iana' opts the product into concrete IANA timezone execution and requires iana_timezones to declare whether every valid identifier or an exact subset is supported.",
          "properties": {
            "ext": {
              "$ref": "#/definitions/Shared3"
            },
            "iana_timezones": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Shared0"
                },
                {
                  "items": {
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "description": "Concrete timezone identifier in the implementation's supported IANA Time Zone Database, such as America/New_York, CET, or UTC.",
                    "maxLength": 255,
                    "minLength": 1,
                    "not": {
                      "const": "inventory_local"
                    },
                    "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$",
                    "title": "IANA Timezone Identifier",
                    "type": "string",
                    "x-adcp-validation": {
                      "iana_timezone": "value_must_resolve_in_the_implementations_supported_IANA_TZDB"
                    },
                    "x-added-in": "3.2.0"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                }
              ],
              "description": "Concrete IANA timezone identifiers accepted by this product. true means every identifier valid in the seller's supported IANA TZDB; an array is the exact supported subset. Required when timezone_modes includes iana and forbidden otherwise."
            },
            "timezone_modes": {
              "items": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "description": "Clock modes a product supports for daypart targeting.",
                "enum": [
                  "inventory_local",
                  "iana"
                ],
                "title": "Daypart Timezone Mode",
                "type": "string",
                "x-added-in": "3.2.0"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "timezone_modes"
          ],
          "type": "object"
        }
      ]
    },
    "keywordSupport": {
      "anyOf": [
        {
          "$ref": "#/definitions/supported"
        },
        {
          "additionalProperties": false,
          "properties": {
            "ext": {
              "$ref": "#/definitions/Shared3"
            },
            "supported_match_types": {
              "items": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "description": "Keyword targeting match type. broad: ads may serve on queries semantically related to the keyword. phrase: ads serve when the query contains the keyword phrase. exact: ads serve only when the query matches the keyword exactly.",
                "enum": [
                  "broad",
                  "phrase",
                  "exact"
                ],
                "enumDescriptions": {
                  "broad": "Ads may serve on queries semantically related to the keyword",
                  "exact": "Ads serve only when the query matches the keyword exactly",
                  "phrase": "Ads serve when the query contains the keyword phrase in order"
                },
                "title": "Match Type",
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "supported_match_types"
          ],
          "type": "object"
        }
      ]
    },
    "metroSupport": {
      "anyOf": [
        {
          "$ref": "#/definitions/supported"
        },
        {
          "additionalProperties": false,
          "properties": {
            "ext": {
              "$ref": "#/definitions/Shared3"
            },
            "max_packages": {
              "description": "Optional maximum number of independently targeted packages the seller will create from this configured product.",
              "minimum": 1,
              "type": "integer"
            },
            "max_values_per_package": {
              "$ref": "#/definitions/Shared4"
            },
            "systems": {
              "items": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "description": "Metro area classification systems for geographic targeting",
                "enum": [
                  "nielsen_dma",
                  "uk_itl1",
                  "uk_itl2",
                  "eurostat_nuts2",
                  "custom"
                ],
                "title": "Metro Area System",
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "systems"
          ],
          "type": "object"
        }
      ]
    },
    "placeCatalogSupport": {
      "additionalProperties": false,
      "description": "Selectable country/type pairs and catalog versions for one identifier system.",
      "properties": {
        "countries": {
          "additionalProperties": {
            "items": {
              "$schema": "http://json-schema.org/draft-07/schema#",
              "anyOf": [
                {
                  "enum": [
                    "airport",
                    "borough",
                    "city",
                    "city_region",
                    "commune",
                    "county",
                    "district",
                    "municipality",
                    "neighborhood",
                    "post_town",
                    "prefecture",
                    "province",
                    "quarter",
                    "state",
                    "territory",
                    "ward"
                  ],
                  "type": "string"
                },
                {
                  "$ref": "#/definitions/Shared6"
                }
              ],
              "description": "Canonical place classification. Registered tokens have protocol-defined meanings. Catalog-specific classifications without a registered mapping MUST use an absolute HTTPS URI controlled by the vocabulary owner; consumers compare URI types as exact opaque strings.",
              "examples": [
                "city",
                "municipality",
                "borough",
                "neighborhood",
                "post_town",
                "city_region",
                "county",
                "https://seller.example/geo/place-types/trade-area"
              ],
              "title": "Geographic Place Type"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/definitions/Shared5"
          },
          "type": "object"
        },
        "current_version": {
          "description": "Version applied when a later package overlay omits system_version. Must be present in system_versions.",
          "minLength": 1,
          "type": "string"
        },
        "ext": {
          "$ref": "#/definitions/Shared3"
        },
        "system_versions": {
          "description": "Exact catalog versions selectable on later package overlays.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "countries",
        "current_version",
        "system_versions"
      ],
      "type": "object",
      "x-adcp-validation": {
        "description": "JSON Schema draft-07 cannot express scalar membership in a sibling array; conformance tooling MUST verify current_version is present in system_versions.",
        "member_of": {
          "array_field": "system_versions",
          "field": "current_version"
        }
      }
    },
    "placeSupport": {
      "additionalProperties": false,
      "description": "Binding permission to select named-place values later, keyed first by identifier system and then by country to avoid namespace and place-type collisions.",
      "properties": {
        "ext": {
          "$ref": "#/definitions/Shared3"
        },
        "max_packages": {
          "description": "Optional maximum number of independently place-targeted packages the seller will create from this configured product.",
          "minimum": 1,
          "type": "integer"
        },
        "max_values_per_package": {
          "$ref": "#/definitions/Shared4"
        },
        "systems": {
          "additionalProperties": {
            "$ref": "#/definitions/placeCatalogSupport"
          },
          "minProperties": 1,
          "propertyNames": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "anyOf": [
              {
                "enum": [
                  "geonames",
                  "google_ads",
                  "microsoft_ads"
                ],
                "type": "string"
              },
              {
                "$ref": "#/definitions/Shared6"
              }
            ],
            "description": "Collision-safe identifier namespace for geographic places. Registered tokens have protocol-defined semantics. Unregistered systems MUST use an absolute HTTPS URI controlled by the catalog owner; consumers compare URI systems as exact opaque strings.",
            "examples": [
              "geonames",
              "google_ads",
              "microsoft_ads",
              "https://seller.example/geo/catalogs/places"
            ],
            "title": "Geographic Place Identifier System"
          },
          "type": "object"
        }
      },
      "required": [
        "systems"
      ],
      "type": "object"
    },
    "supported": {
      "$ref": "#/definitions/Shared0"
    }
  },
  "description": "Product-scoped package targeting dimensions that may be supplied or changed after discovery. This is the seller response shape and may disclose seller limits such as max_values_per_package and max_packages. Product.overlay_support is the binding selectable-targeting contract: presence means the seller can apply protocol-valid values within the declared systems, countries, values, types, versions, and limits. Inherent product coverage alone does not satisfy a future-support requirement. Support does not guarantee inventory or a value-specific forecast before values are supplied; fixed prices and floors remain binding for supported selections. geo_regions and geo_regions_exclude are independent: structured support either exhaustively declares every value active in the seller's support snapshot for a country or lists the exact finite selectable subset. Buyer minimums use targeting-overlay-requirements.json. A requirement value of true matches true or any valid support object; an object requirement matches true or a containing support object. The daypart_targets boolean is the backward-compatible exception: true promises inventory_local only, and structured support opts into IANA zones. Every valid structured support object represents a positive capability; empty, extension-only, and false-only objects are invalid. Unrequested object fields and numeric seller limits do not participate in matching. A product declares at most one of frequency_cap: true and frequency_cap_support. Legacy frequency_cap: true keeps its broad meaning within seller-wide limits, including update support. A constrained or create-only product instead advertises frequency_cap_support, so older buyers safely treat it as unsupported.",
