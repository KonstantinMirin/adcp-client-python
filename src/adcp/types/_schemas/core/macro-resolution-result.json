                "type": "object"
              },
              "type": "object"
            },
            {
              "properties": {
                "depth": {
                  "const": 1
                },
                "kind": {
                  "const": "iab_vast_uri"
                }
              },
              "required": [
                "kind"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "not": {
                "properties": {
                  "kind": {
                    "const": "none"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              "type": "object"
            },
            {
              "properties": {
                "depth": {
                  "const": 0
                },
                "kind": {
                  "const": "none"
                }
              },
              "required": [
                "kind"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "not": {
                "properties": {
                  "kind": {
                    "const": "rfc3986"
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              "type": "object"
            },
            {
              "properties": {
                "depth": {
                  "minimum": 1
                },
                "kind": {
                  "const": "rfc3986"
                }
              },
              "required": [
                "kind"
              ]
            }
          ]
        }
      ],
      "description": "Exact encoding profile applied to a concrete substitution value. `rfc3986` encodes UTF-8 bytes outside the RFC 3986 unreserved set once per depth. `iab_vast_uri` follows the cited IAB VAST macro registry, including its array serialization rules, and is exactly one pass.",
      "maxProperties": 2,
      "properties": {
        "depth": {
