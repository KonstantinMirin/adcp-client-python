{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "dialect": {
            "enum": [
              "iab_vast",
              "iab_daast",
              "vendor"
            ]
          }
        },
        "required": [
          "dialect"
        ]
      },
      "then": {
        "required": [
          "dialect_namespace",
          "dialect_revision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "dialect": {
            "enum": [
              "adcp",
              "unknown"
            ]
          }
        },
        "required": [
          "dialect"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "dialect_namespace"
              ]
            },
            {
              "required": [
                "dialect_revision"
              ]
            }
          ]
        }
      }
    },
    {
      "else": {
        "not": {
          "required": [
            "universal_semantic"
          ]
        }
      },
      "if": {
        "properties": {
          "mapping_status": {
            "const": "verified_universal"
          }
        },
        "required": [
          "mapping_status"
        ]
      },
      "then": {
        "required": [
          "universal_semantic"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "translate_to_native",
              "resolve_value"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "performed_by"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "dialect": {
            "enum": [
              "iab_vast",
              "iab_daast"
            ]
          },
          "operation": {
            "const": "resolve_value"
          }
        },
        "required": [
          "dialect",
          "operation"
        ]
      },
      "then": {
        "properties": {
          "performed_by": {
            "const": "request_executor"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dialect": {
            "const": "adcp"
          }
        },
        "required": [
          "dialect"
        ]
      },
      "then": {
        "properties": {
          "dialect_semantic": {
            "enum": [
              "OS",
              "DMA",
              "LAT",
              "SKU",
              "ZIP",
              "AXEM",
              "CITY",
              "GDPR",
              "GTIN",
              "LONG",
              "TMPX",
              "DOMAIN",
              "JOB_ID",
              "REGION",
              "COUNTRY",
              "GPP_SID",
              "AD_WIDTH",
              "APP_NAME",
              "HOTEL_ID",
              "KEYWORDS",
              "PAGE_URL",
              "POD_SIZE",
              "REFERRER",
              "STORE_ID",
              "VIDEO_ID",
              "AD_HEIGHT",
              "CLICK_URL",
              "DEVICE_ID",
              "FLIGHT_ID",
              "ITEM_NAME",
              "TIMESTAMP",
              "APP_BUNDLE",
              "CATALOG_ID",
              "GPP_STRING",
              "IP_ADDRESS",
              "ITEM_PRICE",
