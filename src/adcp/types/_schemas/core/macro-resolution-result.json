              "CACHEBUSTER",
              "CREATIVE_ID",
              "DEVICE_MAKE",
              "DEVICE_TYPE",
              "OFFERING_ID",
              "VIDEO_TITLE",
              "DEVICE_MODEL",
              "GDPR_CONSENT",
              "ITEM_TAGLINE",
              "MEDIA_BUY_ID",
              "PLACEMENT_ID",
              "PLAYER_WIDTH",
              "POD_POSITION",
              "CONTENT_GENRE",
              "FOLD_POSITION",
              "IMPRESSION_ID",
              "PLAYER_HEIGHT",
              "AUDIO_DURATION",
              "CONTENT_RATING",
              "DESTINATION_ID",
              "DEVICE_ID_TYPE",
              "INSTALLMENT_ID",
              "VIDEO_CATEGORY",
              "VIDEO_DURATION",
              "COLLECTION_NAME",
              "ITEM_DESCRIPTION",
              "LIMIT_AD_TRACKING",
              "CREATIVE_VARIANT_ID",
              "ITEM_PRICE_CURRENCY"
            ]
          },
          "mapping_status": {
            "const": "verified_universal"
          }
        },
        "required": [
          "universal_semantic"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "dialect": {
            "const": "unknown"
          }
        },
        "required": [
          "dialect"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "performed_by"
              ]
            },
            {
              "required": [
                "universal_semantic"
              ]
            }
          ]
        },
        "properties": {
          "mapping_status": {
            "const": "unresolved"
          },
          "operation": {
            "const": "preserve"
          },
          "reason": {
            "const": "preserved_unknown"
          },
          "requested_encoding": {
            "properties": {
              "depth": {
                "const": 0
              },
              "kind": {
                "const": "none"
              }
            }
          },
          "required": {
            "const": false
          },
          "status": {
            "const": "preserved_for_downstream"
          },
          "unavailable_behavior": {
            "const": "preserve"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "preserve"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "not": {
          "required": [
            "performed_by"
          ]
        },
        "properties": {
          "requested_encoding": {
            "properties": {
              "depth": {
                "const": 0
              },
              "kind": {
                "const": "none"
              }
            }
          },
          "required": {
            "const": false
          },
          "status": {
            "const": "preserved_for_downstream"
          },
          "unavailable_behavior": {
            "const": "preserve"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "required": {
            "const": true
          }
        },
        "required": [
          "required"
        ]
      },
      "then": {
        "properties": {
          "unavailable_behavior": {
            "const": "reject"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "resolvable"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "const": "capability_match"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "preserved_for_downstream"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "required": [
            "performed_by"
          ]
        },
        "properties": {
          "operation": {
            "const": "preserve"
          },
          "reason": {
            "enum": [
              "preserved_unknown",
              "preserved_for_downstream"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unsupported"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "dialect_unsupported",
              "namespace_mismatch",
              "revision_mismatch",
              "semantic_unsupported",
              "operation_unsupported",
              "resolver_mismatch",
              "context_unsupported",
              "encoding_unsupported"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ambiguous"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "const": "ambiguous_mapping"
          }
        }
      }
    }
  ],
  "description": "Path-addressable preflight result for one declaration. `resolvable` means the selected execution path advertises the exact operation; it does not claim that serve-time substitution has already occurred.",
  "properties": {
    "asset_path": {
      "description": "JSON Pointer to the asset carrying the declaration.",
      "pattern": "^/",
      "type": "string"
    },
    "declaration_id": {
      "minLength": 1,
      "type": "string",
      "x-entity": "macro_declaration"
    },
    "dialect": {
      "enum": [
        "adcp",
        "vendor",
        "unknown",
        "iab_vast",
        "iab_daast"
      ]
    },
    "dialect_namespace": {
      "format": "uri",
      "type": "string"
    },
    "dialect_revision": {
      "minLength": 1,
      "type": "string"
    },
    "dialect_semantic": {
      "minLength": 1,
      "type": "string"
    },
    "mapping_status": {
      "enum": [
        "unresolved",
        "dialect_defined",
        "verified_universal"
      ]
    },
    "matched_encodings": {
      "description": "Exact advertised profiles considered for this match, when relevant.",
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {
          "not": {}
        },
        "allOf": [
          {
            "anyOf": [
              {
                "not": {
                  "properties": {
                    "kind": {
                      "const": "iab_vast_uri"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "type": "object"
                },
                "type": "object"
              },
              {
                "properties": {
                  "depth": {
                    "const": 1
                  },
                  "kind": {
                    "const": "iab_vast_uri"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            ]
          },
          {
            "anyOf": [
              {
                "not": {
                  "properties": {
                    "kind": {
                      "const": "none"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "type": "object"
                },
                "type": "object"
              },
              {
                "properties": {
                  "depth": {
                    "const": 0
                  },
                  "kind": {
                    "const": "none"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            ]
          },
          {
            "anyOf": [
              {
                "not": {
                  "properties": {
                    "kind": {
                      "const": "rfc3986"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "type": "object"
                },
                "type": "object"
              },
              {
                "properties": {
                  "depth": {
                    "minimum": 1
                  },
                  "kind": {
                    "const": "rfc3986"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            ]
          }
        ],
        "description": "Exact encoding profile applied to a concrete substitution value. `rfc3986` encodes UTF-8 bytes outside the RFC 3986 unreserved set once per depth. `iab_vast_uri` follows the cited IAB VAST macro registry, including its array serialization rules, and is exactly one pass.",
        "maxProperties": 2,
        "properties": {
          "depth": {
            "minimum": 0,
            "type": "integer"
          },
          "kind": {
            "enum": [
              "none",
              "rfc3986",
              "iab_vast_uri"
            ]
          }
        },
        "required": [
          "depth",
          "kind"
        ],
        "title": "Macro Encoding",
        "type": "object"
      },
      "type": "array"
    },
    "message": {
      "minLength": 1,
      "type": "string"
    },
    "operation": {
      "enum": [
        "preserve",
        "resolve_value",
        "translate_to_native"
      ]
    },
    "performed_by": {
      "enum": [
        "buyer",
        "seller",
        "creative_agent",
        "request_executor",
        "source_ad_server"
      ]
    },
    "reason": {
      "enum": [
        "capability_match",
        "ambiguous_mapping",
        "preserved_unknown",
        "resolver_mismatch",
        "revision_mismatch",
        "namespace_mismatch",
        "context_unsupported",
        "dialect_unsupported",
        "encoding_unsupported",
        "semantic_unsupported",
        "operation_unsupported",
        "preserved_for_downstream"
      ]
    },
    "requested_encoding": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": {
