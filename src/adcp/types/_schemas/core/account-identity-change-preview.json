{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Shared0": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
    },
    "Shared1": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "description": "The buyer-desired operator portion of an advertiser account identity. The operator domain identifies the entity operating for the brand; operator_unit identifies that operator's internal buying context. Buyers that already administer the account control unit metadata and identity within the current operator. Changing the operator domain is an inter-entity handoff that requires seller-mediated approval by the current account authority, the brand, and the destination operator. When used as a sync_accounts settings-update value, this object is a complete desired replacement: omitting operator_unit removes the current unit rather than preserving it.",
      "properties": {
        "operator": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "description": "Domain of the entity operating on the brand's behalf. When the brand operates directly, this is the brand's domain.",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
          "title": "Domain Name",
          "type": "string",
          "x-entity": "operator"
        },
        "operator_unit": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "additionalProperties": false,
          "description": "Optional operator-owned business unit, agency seat, or platform account. Its id participates in account identity; name is mutable display metadata. Omission from a complete desired replacement means the account should have no operator unit.",
          "examples": [
            {
              "id": "234284238",
              "name": "Nova EMEA"
            },
            {
              "id": "benelux-seat",
              "name": "Nova Benelux"
            }
          ],
          "properties": {
            "id": {
              "description": "Stable identifier assigned by the operator. Numeric platform IDs and durable slugs are both valid. Scoped by the enclosing operator domain.",
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            "name": {
              "description": "Human-readable seat or business-unit name, such as Nova EMEA. This label may change and is not part of the natural account key.",
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "title": "Operator Unit",
          "type": "object",
          "x-entity": "operator_unit"
        }
      },
      "required": [
        "operator"
      ],
      "title": "Operator Identity",
      "type": "object"
    },
    "blocked_impacts": {
      "contains": {
        "properties": {
          "effect": {
            "const": "blocked"
          }
        },
        "required": [
          "effect"
        ],
        "type": "object"
      },
      "description": "Account areas evaluated for a blocked change. At least one impact identifies the blocking area.",
      "items": {
        "$ref": "#/definitions/impact"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    },
    "impact": {
      "additionalProperties": false,
      "properties": {
        "area": {
          "enum": [
            "account_id",
            "media_buys",
            "reporting",
            "approval",
            "billing",
            "grants",
            "other"
          ],
          "type": "string"
        },
        "effect": {
          "enum": [
            "preserved",
            "revalidation_required",
            "revoke_and_regrant",
            "blocked"
          ],
          "type": "string"
        },
        "reason": {
          "$ref": "#/definitions/Shared0"
        }
      },
      "required": [
        "area",
        "effect"
      ],
      "type": "object"
    },
    "nonblocking_impacts": {
      "description": "Account areas the seller evaluated for continuity or reauthorization. Non-blocked outcomes cannot carry a blocked effect.",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/impact"
          },
          {
            "properties": {
              "effect": {
                "enum": [
                  "preserved",
                  "revalidation_required",
                  "revoke_and_regrant"
                ]
              }
            }
          }
        ]
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    }
  },
  "description": "Non-persisted dry-run result for a requested operator-identity change. Canonical account fields and revision remain unchanged.",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "impacts": {
          "$ref": "#/definitions/nonblocking_impacts"
        },
        "outcome": {
          "const": "would_apply",
          "type": "string"
        },
        "requested_operator_identity": {
          "$ref": "#/definitions/Shared1"
        }
      },
      "required": [
        "outcome",
        "requested_operator_identity",
        "impacts"
      ],
      "title": "AccountIdentityChangeWouldApply",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "impacts": {
          "$ref": "#/definitions/nonblocking_impacts"
        },
        "outcome": {
          "const": "would_require_approval",
          "type": "string"
        },
        "requested_operator_identity": {
          "$ref": "#/definitions/Shared1"
        }
      },
      "required": [
        "outcome",
        "requested_operator_identity",
        "impacts"
      ],
      "title": "AccountIdentityChangeWouldRequireApproval",
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "items": {
            "$ref": "#/definitions/Shared0"
          },
          "minItems": 1,
          "type": "array"
        },
        "impacts": {
          "$ref": "#/definitions/blocked_impacts"
        },
        "outcome": {
          "const": "blocked",
          "type": "string"
        },
        "requested_operator_identity": {
          "$ref": "#/definitions/Shared1"
        }
      },
      "required": [
        "outcome",
        "requested_operator_identity",
        "impacts",
        "blockers"
      ],
      "title": "AccountIdentityChangeBlocked",
      "type": "object"
    }
  ],
  "title": "Account Identity Change Preview"
}
