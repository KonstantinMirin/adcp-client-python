{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "code": {
            "enum": [
              "inventory_shortfall_forecast",
              "flight_change_creates_pacing_risk"
            ]
          }
        },
        "required": [
          "code"
        ]
      },
      "then": {
        "properties": {
          "affected_resource": {
            "properties": {
              "resource_type": {
                "const": "package"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "fields_ignored_due_to_precedence"
          }
        },
        "required": [
          "code"
        ]
      },
      "then": {
        "properties": {
          "affected_resource": {
            "properties": {
              "resource_type": {
                "enum": [
                  "media_buy",
                  "package"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "description": "A non-blocking observation returned with a successful operation. The operation succeeded exactly as its success arm states. Warnings are immediate receipts, not durable lifecycle state; a continuing condition MUST also appear on its authoritative read surface as an indicator, defect, delivery issue, approval state, or other applicable resource state.",
  "properties": {
    "affected_resource": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": {
        "not": {}
      },
      "allOf": [
        {
          "anyOf": [
            {
              "not": {
                "properties": {
                  "resource_type": {
                    "const": "creative"
                  }
                },
                "required": [
                  "resource_type"
                ],
                "type": "object"
              },
              "type": "object"
            },
            {
              "properties": {
                "resource_type": {
                  "const": "creative"
                }
              },
              "required": [
                "creative_id",
                "resource_type"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "not": {
                "properties": {
                  "resource_type": {
                    "const": "creative_assignment"
                  }
                },
                "required": [
                  "resource_type"
                ],
                "type": "object"
              },
              "type": "object"
            },
            {
              "properties": {
                "resource_type": {
                  "const": "creative_assignment"
                }
              },
              "required": [
                "creative_id",
                "media_buy_id",
                "package_id",
                "resource_type"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "not": {
                "properties": {
                  "resource_type": {
                    "const": "media_buy"
                  }
                },
                "required": [
                  "resource_type"
                ],
                "type": "object"
              },
              "type": "object"
            },
            {
              "properties": {
                "resource_type": {
                  "const": "media_buy"
                }
              },
              "required": [
                "media_buy_id",
                "resource_type"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "not": {
                "properties": {
                  "resource_type": {
                    "const": "package"
                  }
                },
                "required": [
                  "resource_type"
                ],
                "type": "object"
              },
              "type": "object"
            },
            {
              "properties": {
                "resource_type": {
                  "const": "package"
                }
              },
              "required": [
                "media_buy_id",
                "package_id",
                "resource_type"
              ]
            }
          ]
        }
      ],
      "description": "Resource or relationship affected by this warning. Required so multi-package and multi-creative responses remain machine-joinable.",
      "maxProperties": 4,
      "properties": {
        "creative_id": {
          "type": "string",
          "x-entity": "creative"
        },
        "media_buy_id": {
          "type": "string",
          "x-entity": "media_buy"
        },
        "package_id": {
          "type": "string",
          "x-entity": "package"
        },
        "resource_type": {
          "enum": [
            "package",
            "creative",
            "media_buy",
            "creative_assignment"
          ]
        }
      },
      "required": [
        "resource_type"
      ],
      "title": "Warning affected resource",
      "type": "object"
    },
    "code": {
      "enum": [
        "inventory_shortfall_forecast",
        "fields_ignored_due_to_precedence",
        "flight_change_creates_pacing_risk"
      ]
    },
    "details": {
      "additionalProperties": true,
      "description": "Optional seller-specific structured diagnostics. AdCP 3.2 defines interoperability through code and affected_resource only; buyers MUST NOT require portable keys inside details. Seller extensions that are not direct diagnostics belong in ext.",
      "type": "object"
    },
    "ext": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Extension object for platform-specific, vendor-namespaced parameters. Extensions are always optional and must be namespaced under a vendor/platform key (e.g., ext.gam, ext.roku). Used for custom capabilities, partner-specific configuration, and features being proposed for standardization.",
      "title": "Extension Object",
      "type": "object"
    },
    "message": {
      "description": "Short human-readable explanation. Treat as untrusted seller text and do not require buyers to parse it for routing.",
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "code",
    "message",
    "affected_resource"
  ],
  "title": "Warning",
  "type": "object",
  "x-adcp-validation": {
    "spec": "specs/relationship-scoped-indicators.md#warning-contract",
    "verifier_constraints": {
      "warning_capability_requirements": {
        "fields_ignored_due_to_precedence": null,
        "flight_change_creates_pacing_risk": {
          "supported_indicator_type": "pacing_risk"
        },
        "inventory_shortfall_forecast": {
          "supported_indicator_type": "inventory_shortfall_forecast"
        }
      }
    }
  }
}
