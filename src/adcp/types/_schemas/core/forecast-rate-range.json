{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": true,
      "anyOf": [
        {
          "required": [
            "mid"
          ]
        },
        {
          "required": [
            "low",
            "high"
          ]
        }
      ],
      "description": "A forecast value with optional confidence bounds. Either mid (point estimate) or both low and high (range) must be provided. mid represents the most likely outcome. low and high represent conservative and optimistic estimates. All three can be provided together.",
      "properties": {
        "high": {
          "description": "Optimistic (high-end) forecast value",
          "minimum": 0,
          "type": "number"
        },
        "low": {
          "description": "Conservative (low-end) forecast value",
          "minimum": 0,
          "type": "number"
        },
        "mid": {
          "description": "Expected (most likely) forecast value",
          "minimum": 0,
          "type": "number"
        }
      },
      "title": "Forecast Range",
      "type": "object"
    },
    {
      "properties": {
        "high": {
          "maximum": 1
        },
        "low": {
          "maximum": 1
        },
        "mid": {
          "maximum": 1
        }
      }
    }
  ],
  "description": "A forecast range whose low, midpoint, and high values are rates in the inclusive interval from 0 to 1.",
  "title": "Forecast Rate Range"
}
