{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {
    "$ref": "#/definitions/Shared0"
  },
  "definitions": {
    "Shared0": {
      "type": "boolean"
    },
    "Shared1": {
      "additionalProperties": false,
      "properties": {
        "cost_per_strengths": {
          "description": "cost_per strengths supported when combined with max_bid.",
          "items": {
            "$ref": "#/definitions/Shared13"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "kind": {
          "const": "max_bid_with_cost_per",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "cost_per_strengths"
      ],
      "type": "object"
    },
    "Shared10": {
      "required": [
        "supported_combinations"
      ]
    },
    "Shared11": {
      "else": {
        "not": {
          "$ref": "#/definitions/Shared15"
        }
      },
      "if": {
        "properties": {
          "modes": {
            "contains": {
              "const": "cost_per"
            }
          }
        },
        "required": [
          "modes"
        ]
      },
      "then": {
        "$ref": "#/definitions/Shared15"
      }
    },
    "Shared12": {
      "else": {
        "not": {
          "$ref": "#/definitions/Shared16"
        }
      },
      "if": {
        "properties": {
          "modes": {
            "contains": {
              "const": "roas"
            }
          }
        },
        "required": [
          "modes"
        ]
      },
      "then": {
        "$ref": "#/definitions/Shared16"
      }
    },
    "Shared13": {
      "enum": [
        "cap",
        "target"
      ],
      "type": "string"
    },
    "Shared14": {
      "enum": [
        "floor",
        "target"
      ],
      "type": "string"
    },
    "Shared15": {
      "required": [
        "cost_per_strengths"
      ]
    },
    "Shared16": {
      "required": [
        "roas_strengths"
      ]
    },
    "Shared2": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "max_bid_with_roas",
          "type": "string"
        },
        "roas_strengths": {
          "description": "roas strengths supported when combined with max_bid.",
          "items": {
            "$ref": "#/definitions/Shared14"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "roas_strengths"
      ],
      "type": "object"
    },
    "Shared3": {
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/definitions/Shared11"
        },
        {
          "$ref": "#/definitions/Shared12"
        }
      ],
      "anyOf": [
        {
          "$ref": "#/definitions/Shared9"
        },
        {
          "$ref": "#/definitions/Shared10"
        }
      ],
      "description": "Policies supported when budget allocation is fixed or omitted.",
      "properties": {
        "cost_per_strengths": {
          "$ref": "#/definitions/Shared6"
        },
        "modes": {
          "$ref": "#/definitions/Shared5"
        },
        "roas_strengths": {
          "$ref": "#/definitions/Shared7"
        },
        "supported_combinations": {
          "$ref": "#/definitions/Shared8"
        }
      },
      "type": "object"
    },
    "Shared4": {
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/definitions/Shared11"
        },
        {
          "$ref": "#/definitions/Shared12"
        }
      ],
      "anyOf": [
        {
          "$ref": "#/definitions/Shared9"
        },
        {
          "$ref": "#/definitions/Shared10"
        }
      ],
      "description": "Policies supported when budget_allocation.mode is seller_optimized.",
      "properties": {
        "cost_per_strengths": {
          "$ref": "#/definitions/Shared6"
        },
        "modes": {
          "$ref": "#/definitions/Shared5"
        },
        "roas_strengths": {
          "$ref": "#/definitions/Shared7"
        },
        "supported_combinations": {
          "$ref": "#/definitions/Shared8"
        }
      },
      "type": "object"
    },
    "Shared5": {
      "description": "Standalone policy modes accepted in this exact scope and allocation context. Combination-only components belong only in supported_combinations and need not appear here. `automatic` means the seller accepts and preserves an explicit `{automatic:true}` authored block; omission only invokes inheritance/default behavior.",
      "items": {
        "enum": [
          "automatic",
          "bid_amount",
          "max_bid",
          "cost_per",
          "roas"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "Shared6": {
      "description": "Supported standalone cost_per strengths in this profile. Required exactly when modes includes cost_per.",
      "items": {
        "$ref": "#/definitions/Shared13"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "Shared7": {
      "description": "Supported standalone roas strengths in this profile. Required exactly when modes includes roas.",
      "items": {
        "$ref": "#/definitions/Shared14"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "Shared8": {
      "description": "Multi-field policies supported in this exact scope and allocation context. Each entry independently qualifies the strengths supported in that combination; standalone strength support does not imply combination support. Absence means no multi-field combination is claimed.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/Shared1"
          },
          {
            "$ref": "#/definitions/Shared2"
          }
        ]
      },
      "minItems": 1,
      "type": "array"
    },
    "Shared9": {
      "required": [
        "modes"
      ]
    }
  },
  "description": "Compact seller features relevant to canonical product purchase. Legacy inline-creative capabilities are absent.",
  "properties": {
    "bidding_policy": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "definitions": {
        "max_bid_with_cost_per": {
          "$ref": "#/definitions/Shared1"
        },
        "max_bid_with_roas": {
          "$ref": "#/definitions/Shared2"
        },
        "policy_profile": {
          "additionalProperties": false,
          "allOf": [
            {
              "$ref": "#/definitions/Shared11"
            },
            {
              "$ref": "#/definitions/Shared12"
            }
          ],
          "anyOf": [
            {
              "$ref": "#/definitions/Shared9"
            },
            {
              "$ref": "#/definitions/Shared10"
            }
          ],
          "properties": {
            "cost_per_strengths": {
              "$ref": "#/definitions/Shared6"
            },
            "modes": {
              "$ref": "#/definitions/Shared5"
            },
            "roas_strengths": {
              "$ref": "#/definitions/Shared7"
            },
            "supported_combinations": {
              "$ref": "#/definitions/Shared8"
            }
          },
          "type": "object"
        },
        "scope_capability": {
          "additionalProperties": false,
          "description": "Support at one authored scope, partitioned by the media buy's resulting allocation mode. Omitted contexts are unsupported; claims in one context make no claim about the other.",
          "minProperties": 1,
          "properties": {
            "fixed": {
              "$ref": "#/definitions/Shared3"
            },
            "seller_optimized": {
              "$ref": "#/definitions/Shared4"
            }
          },
          "type": "object"
        }
      },
      "description": "Structured declaration of the canonical bidding policies a seller can preserve without semantic translation. Media-buy/package authored scope and fixed/seller-optimized allocation context are advertised independently. Buyers MUST inspect the exact scope, allocation context, mode, strength, and combination rather than treating presence of this object as blanket support.",
      "minProperties": 1,
      "properties": {
        "media_buy": {
          "additionalProperties": false,
          "description": "Policies accepted at media-buy scope and inherited by packages that omit a package override.",
          "minProperties": 1,
          "properties": {
            "fixed": {
              "$ref": "#/definitions/Shared3"
            },
            "seller_optimized": {
              "$ref": "#/definitions/Shared4"
            }
          },
          "type": "object"
        },
        "package": {
          "additionalProperties": false,
          "description": "Policies accepted as package-authored policies, including explicit automatic overrides.",
          "minProperties": 1,
          "properties": {
            "fixed": {
              "$ref": "#/definitions/Shared3"
            },
            "seller_optimized": {
              "$ref": "#/definitions/Shared4"
            }
          },
          "type": "object"
        }
      },
      "title": "Bidding Policy Capability",
      "type": "object",
      "x-adcp-hoist": true
    },
    "catalog_management": {
      "$ref": "#/definitions/Shared0"
    },
    "property_filtering": {
      "$ref": "#/definitions/Shared0"
    },
    "reporting_commitment_snapshots": {
      "description": "Seller preserves the accepted per-purchase reporting contract and exposes it on proposal and MediaBuy readback.",
      "type": "boolean"
    },
    "seller_optimized_budget": {
      "description": "Core seller-optimized shared-budget contract: shared total_budget, seller allocation across packages, media-buy pacing, and allocation echo.",
      "type": "boolean"
    },
    "seller_optimized_min_spend_targets": {
      "description": "Package minimum-spend targets inside seller-optimized buys; implies seller_optimized_budget.",
      "type": "boolean"
    },
    "seller_optimized_package_budgets": {
      "description": "Package budget caps inside seller-optimized buys; implies seller_optimized_budget.",
      "type": "boolean"
    },
    "seller_optimized_package_pacing": {
      "description": "Package pacing inside seller-optimized buys; implies seller_optimized_budget.",
      "type": "boolean"
    }
  },
  "title": "Canonical Media Buy Features",
  "type": "object"
}
