{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Canonical fixed or seller-optimized allocation using only canonical optimization goals.",
  "discriminator": {
    "propertyName": "mode"
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "fixed",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "seller_optimized",
          "type": "string"
        },
        "optimization_goals": {
          "items": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "description": "Canonical 3.2 optimization objective. Monetary execution policy belongs in BiddingPolicy; legacy monetary targets and unbound attention metrics are excluded.",
            "discriminator": {
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "metric": {
                          "const": "viewable_rate"
                        }
                      },
                      "required": [
                        "metric"
                      ]
                    },
                    "then": {
                      "properties": {
                        "target": {
                          "properties": {
                            "value": {
                              "maximum": 1
                            }
                          }
                        }
                      },
                      "required": [
                        "standard"
                      ]
                    }
                  },
                  {
                    "else": {
                      "not": {
                        "anyOf": [
                          {
                            "required": [
                              "standard"
                            ]
                          },
                          {
                            "required": [
                              "vendor"
                            ]
                          }
                        ]
                      }
                    },
                    "if": {
                      "properties": {
                        "metric": {
                          "enum": [
                            "viewable_rate",
                            "viewed_seconds"
                          ]
                        }
                      },
                      "required": [
                        "metric"
                      ]
                    }
                  }
                ],
                "properties": {
                  "kind": {
                    "const": "metric",
                    "type": "string"
                  },
                  "metric": {
                    "enum": [
                      "clicks",
                      "views",
                      "completed_views",
                      "viewed_seconds",
                      "viewable_rate",
                      "engagements",
                      "follows",
                      "saves",
                      "profile_visits",
                      "reach"
                    ],
                    "type": "string"
                  },
                  "priority": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "reach_unit": {
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "description": "Unit of measurement for reach and audience size metrics. Different channels and measurement providers count reach in fundamentally different units, making cross-channel comparison impossible without declaring the unit.",
                    "enum": [
                      "individuals",
                      "households",
                      "devices",
                      "accounts",
                      "cookies",
                      "custom"
                    ],
                    "enumDescriptions": {
                      "accounts": "Unique logged-in accounts (platform-specific identity).",
                      "cookies": "Unique browser cookies.",
                      "custom": "Seller-defined reach unit. Describe in ext. For a Product.identity declaration with persistent_identifier false, describe the unit in Product.identity.reach_methodology.",
                      "devices": "Unique device identifiers (IDFA, GAID, CTV device ID).",
                      "households": "Unique households or TV homes.",
                      "individuals": "Unique people. Panel-based or identity-resolved measurement."
                    },
                    "title": "Reach Unit",
                    "type": "string"
                  },
                  "standard": {
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "description": "Viewability measurement standard applied to determine whether an impression qualifies as viewable. These are materially different thresholds and should not be compared across standards.",
                    "enum": [
                      "mrc",
                      "groupm"
                    ],
                    "enumDescriptions": {
                      "groupm": "GroupM standard: 100% of pixels in view for 1 continuous second (display) or 50% of video duration.",
                      "mrc": "MRC/IAB standard: 50% of pixels in view for 1 continuous second (display) or 2 continuous seconds (video)."
                    },
                    "title": "Viewability Standard",
                    "type": "string"
                  },
                  "target": {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "threshold_rate",
                        "type": "string"
                      },
                      "value": {
                        "exclusiveMinimum": 0,
                        "type": "number"
                      }
                    },
                    "required": [
                      "kind",
                      "value"
                    ],
                    "type": "object"
                  },
                  "target_frequency": {
                    "additionalProperties": false,
                    "anyOf": [
                      {
                        "required": [
                          "min"
                        ]
                      },
                      {
                        "required": [
                          "max"
                        ]
                      }
                    ],
                    "properties": {
                      "max": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "min": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "window": {
                        "$schema": "http://json-schema.org/draft-07/schema#",
                        "additionalProperties": false,
                        "description": "A time duration expressed as an interval and unit. Used for frequency cap windows, attribution windows, reach optimization windows, time budgets, and other time-based settings. When unit is 'campaign', interval must be 1 \u2014 the window spans the full campaign flight.",
                        "properties": {
                          "interval": {
                            "description": "Number of time units. Must be 1 when unit is 'campaign'.",
                            "minimum": 1,
                            "type": "integer"
                          },
                          "unit": {
                            "description": "Time unit. 'seconds' for sub-minute precision. 'campaign' spans the full campaign flight.",
                            "enum": [
                              "seconds",
                              "minutes",
                              "hours",
                              "days",
                              "campaign"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "interval",
                          "unit"
                        ],
                        "title": "Duration",
                        "type": "object"
                      }
                    },
                    "required": [
                      "window"
                    ],
                    "type": "object"
                  },
                  "vendor": {
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "additionalProperties": false,
                    "description": "Stable brand identity used to resolve the canonical brand manifest, optionally qualified by the countries of a commercial advertiser entity. The manifest URL is derived from domain; callers do not send brand assets or per-call brand overrides. Countries do not target delivery.",
                    "properties": {
                      "brand_id": {
                        "$schema": "http://json-schema.org/draft-07/schema#",
                        "description": "Brand within a house-of-brands manifest. Omit for a single-brand domain.",
                        "examples": [
                          "tide",
                          "cheerios",
                          "air_jordan",
                          "nike",
                          "pampers"
                        ],
                        "pattern": "^[a-z0-9_]+$",
                        "title": "Brand ID",
                        "type": "string",
                        "x-entity": "advertiser_brand"
                      },
                      "countries": {
                        "description": "Canonical set of ISO 3166-1 alpha-2 countries for this advertiser identity. Omit when the identity is global or the house does not split the brand geographically. Array order is not meaningful; producers MUST sort codes lexicographically before computing keys or signatures. This qualifies account and proposal identity and is not delivery targeting.",
                        "items": {
                          "pattern": "^[A-Z]{2}$",
                          "type": "string"
                        },
                        "minItems": 1,
                        "type": "array",
                        "uniqueItems": true
                      },
                      "domain": {
                        "description": "Domain that hosts /.well-known/brand.json or is registered for the brand.",
                        "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "domain"
                    ],
                    "title": "Brand Key",
                    "type": "object"
                  },
                  "view_duration_seconds": {
                    "exclusiveMinimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "kind",
                  "metric"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "attribution_window": {
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "additionalProperties": true,
                    "description": "Describes the attribution methodology and lookback windows used for conversion measurement. Enables cross-platform comparison by making attribution methodology transparent. Used as a `$ref` from `optimization-goal.json` (buyer's optimization-time attribution choice), `get-media-buy-delivery-response.json` (seller-declared attribution methodology in delivery reports), and similar surfaces. All fields are optional individually but at least one of `post_click`, `post_view`, or `model` SHOULD be populated; absence of `model` means the seller's default attribution model applies (typically `last_touch` per industry convention) \u2014 sellers SHOULD populate `model` explicitly when committing to a specific methodology.",
                    "properties": {
                      "model": {
                        "$schema": "http://json-schema.org/draft-07/schema#",
                        "description": "Attribution model used to assign credit when multiple touchpoints exist. SHOULD be populated when committing to a specific model; when absent, the seller's default applies.",
                        "enum": [
                          "last_touch",
                          "first_touch",
                          "linear",
                          "time_decay",
                          "data_driven"
                        ],
                        "title": "Attribution Model",
                        "type": "string"
                      },
                      "post_click": {
                        "allOf": [
                          {
                            "$schema": "http://json-schema.org/draft-07/schema#",
                            "additionalProperties": false,
                            "description": "A time duration expressed as an interval and unit. Used for frequency cap windows, attribution windows, reach optimization windows, time budgets, and other time-based settings. When unit is 'campaign', interval must be 1 \u2014 the window spans the full campaign flight.",
                            "properties": {
                              "interval": {
                                "description": "Number of time units. Must be 1 when unit is 'campaign'.",
                                "minimum": 1,
                                "type": "integer"
                              },
                              "unit": {
                                "description": "Time unit. 'seconds' for sub-minute precision. 'campaign' spans the full campaign flight.",
                                "enum": [
                                  "seconds",
                                  "minutes",
                                  "hours",
                                  "days",
                                  "campaign"
                                ],
                                "type": "string"
                              }
                            },
                            "required": [
                              "interval",
                              "unit"
                            ],
                            "title": "Duration",
                            "type": "object"
                          }
                        ],
                        "description": "Post-click attribution window. Conversions occurring within this duration after a click are attributed to the ad."
                      },
                      "post_view": {
                        "allOf": [
                          {
                            "$schema": "http://json-schema.org/draft-07/schema#",
                            "additionalProperties": false,
                            "description": "A time duration expressed as an interval and unit. Used for frequency cap windows, attribution windows, reach optimization windows, time budgets, and other time-based settings. When unit is 'campaign', interval must be 1 \u2014 the window spans the full campaign flight.",
                            "properties": {
                              "interval": {
                                "description": "Number of time units. Must be 1 when unit is 'campaign'.",
                                "minimum": 1,
                                "type": "integer"
                              },
                              "unit": {
                                "description": "Time unit. 'seconds' for sub-minute precision. 'campaign' spans the full campaign flight.",
                                "enum": [
                                  "seconds",
                                  "minutes",
                                  "hours",
                                  "days",
                                  "campaign"
                                ],
                                "type": "string"
                              }
                            },
                            "required": [
                              "interval",
                              "unit"
                            ],
                            "title": "Duration",
                            "type": "object"
                          }
                        ],
                        "description": "Post-view attribution window. Conversions occurring within this duration after an ad impression (without click) are attributed to the ad."
                      }
                    },
                    "title": "Attribution Window",
                    "type": "object"
                  },
                  "event_sources": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "custom_event_name": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "event_source_id": {
                          "minLength": 1,
                          "type": "string",
                          "x-entity": "event_source"
                        },
                        "event_type": {
                          "$schema": "http://json-schema.org/draft-07/schema#",
                          "description": "Standard marketing event types for event logging, aligned with IAB ECAPI",
                          "enum": [
                            "page_view",
                            "view_content",
                            "select_content",
                            "select_item",
                            "search",
                            "share",
                            "add_to_cart",
                            "remove_from_cart",
                            "viewed_cart",
                            "add_to_wishlist",
                            "initiate_checkout",
                            "add_payment_info",
                            "purchase",
                            "refund",
                            "lead",
                            "qualify_lead",
                            "close_convert_lead",
                            "disqualify_lead",
                            "complete_registration",
                            "subscribe",
                            "follow",
                            "content_view",
                            "watch_milestone",
                            "start_trial",
                            "app_install",
                            "app_launch",
                            "contact",
                            "schedule",
                            "donate",
                            "submit_application",
                            "custom"
                          ],
                          "enumDescriptions": {
                            "add_payment_info": "User added payment information",
                            "add_to_cart": "User added an item to cart",
                            "add_to_wishlist": "User added an item to a wishlist",
                            "app_install": "User installed an application",
                            "app_launch": "User launched an application",
                            "close_convert_lead": "Lead converted to a customer or closed deal",
                            "complete_registration": "User completed account registration",
                            "contact": "User initiated contact (call, message, etc.)",
                            "content_view": "User meaningfully consumed a content unit, such as a watch, listen, stream, episode play, or read",
                            "custom": "Custom event type (specify in custom_event_name)",
                            "disqualify_lead": "Lead disqualified or marked as not viable",
                            "donate": "User made a donation",
                            "follow": "User made a free, durable opt-in to an account, channel, feed, list, podcast, or similar owned property",
                            "initiate_checkout": "User started checkout process",
                            "lead": "User expressed interest (form submission, signup, etc.)",
                            "page_view": "User viewed a page",
                            "purchase": "User completed a purchase",
                            "qualify_lead": "Lead qualified by sales or scoring criteria",
                            "refund": "A purchase was fully or partially refunded (adjusts ROAS)",
                            "remove_from_cart": "User removed an item from cart",
                            "schedule": "User scheduled an appointment or event",
                            "search": "User performed a search",
                            "select_content": "User selected or clicked on content (article, video, etc.)",
                            "select_item": "User selected a specific product or item from a list",
                            "share": "User shared content via social or messaging",
                            "start_trial": "User started a free trial",
                            "submit_application": "User submitted an application (loan, job, etc.)",
                            "subscribe": "User started a paid subscription or paid membership",
                            "view_content": "User viewed specific content (product, article, etc.)",
                            "viewed_cart": "User viewed their shopping cart",
                            "watch_milestone": "User reached a content progress threshold, such as 25%, 50%, 75%, 100%, or a seconds-viewed milestone"
                          },
                          "title": "Event Type",
                          "type": "string"
                        },
                        "value_factor": {
                          "default": 1,
                          "type": "number"
                        },
                        "value_field": {
                          "minLength": 1,
                          "type": "string"
                        }
                      },
                      "required": [
                        "event_source_id",
                        "event_type"
                      ],
                      "type": "object"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "kind": {
                    "const": "event",
                    "type": "string"
                  },
                  "priority": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "target": {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "maximize_value",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "kind",
                  "event_sources"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "vendor_metric",
                    "type": "string"
                  },
                  "metric_id": {
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "description": "Identifier for a vendor-defined metric within the vendor's vocabulary. Stable lookup key; the vendor publishes the canonical list (with category, methodology, and standard alignment) in `brand.json` `agents[type='measurement']`. Lowercase with underscores so a future enum promotion into `available-metric.json` is a literal string lift. Identifier is namespaced by the vendor \u2014 the same `metric_id` may mean different things in different vendors' vocabularies.",
                    "examples": [
                      "attention_units",
                      "gco2e_per_impression",
                      "demographic_reach",
                      "co_view_index",
                      "incremental_lift_percent"
                    ],
                    "maxLength": 64,
                    "minLength": 1,
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "title": "Vendor Metric ID",
                    "type": "string",
                    "x-entity": "vendor_metric"
                  },
                  "priority": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "target": {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "threshold_rate",
                        "type": "string"
                      },
                      "value": {
                        "exclusiveMinimum": 0,
                        "type": "number"
                      }
                    },
                    "required": [
                      "kind",
                      "value"
                    ],
                    "type": "object"
                  },
                  "vendor": {
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "additionalProperties": false,
                    "description": "Stable brand identity used to resolve the canonical brand manifest, optionally qualified by the countries of a commercial advertiser entity. The manifest URL is derived from domain; callers do not send brand assets or per-call brand overrides. Countries do not target delivery.",
                    "properties": {
                      "brand_id": {
                        "$schema": "http://json-schema.org/draft-07/schema#",
                        "description": "Brand within a house-of-brands manifest. Omit for a single-brand domain.",
                        "examples": [
                          "tide",
                          "cheerios",
                          "air_jordan",
                          "nike",
                          "pampers"
                        ],
                        "pattern": "^[a-z0-9_]+$",
                        "title": "Brand ID",
                        "type": "string",
                        "x-entity": "advertiser_brand"
                      },
                      "countries": {
                        "description": "Canonical set of ISO 3166-1 alpha-2 countries for this advertiser identity. Omit when the identity is global or the house does not split the brand geographically. Array order is not meaningful; producers MUST sort codes lexicographically before computing keys or signatures. This qualifies account and proposal identity and is not delivery targeting.",
                        "items": {
                          "pattern": "^[A-Z]{2}$",
                          "type": "string"
                        },
                        "minItems": 1,
                        "type": "array",
                        "uniqueItems": true
                      },
                      "domain": {
                        "description": "Domain that hosts /.well-known/brand.json or is registered for the brand.",
                        "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "domain"
                    ],
                    "title": "Brand Key",
                    "type": "object"
                  }
                },
                "required": [
                  "kind",
                  "vendor",
                  "metric_id"
                ],
                "type": "object"
              }
            ],
            "title": "Canonical Optimization Goal"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "mode",
        "optimization_goals"
      ],
      "type": "object"
    }
  ],
  "title": "Canonical Budget Allocation"
}
