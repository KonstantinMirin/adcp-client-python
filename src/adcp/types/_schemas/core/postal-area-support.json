{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {
    "items": {
      "enum": [
        "postal_code",
        "custom"
      ]
    },
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
  },
  "description": "Declares supported postal area systems. Native support is keyed by ISO 3166-1 alpha-2 country with arrays of country-local postal systems. Deprecated country-fused boolean aliases may be included during migration.",
  "properties": {
    "AT": {
      "items": {
        "const": "plz"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "AU": {
      "items": {
        "const": "postcode"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "BR": {
      "items": {
        "const": "cep"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "CA": {
      "items": {
        "enum": [
          "fsa",
          "full"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "CH": {
      "items": {
        "const": "plz"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "DE": {
      "items": {
        "const": "plz"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "FR": {
      "items": {
        "const": "code_postal"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "GB": {
      "items": {
        "enum": [
          "outward",
          "full"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "IN": {
      "items": {
        "const": "pin"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "US": {
      "items": {
        "enum": [
          "zip",
          "zip_plus_four"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "ZA": {
      "items": {
        "const": "postal_code"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "at_plz": {
      "deprecated": true,
      "type": "boolean"
    },
    "au_postcode": {
      "deprecated": true,
      "type": "boolean"
    },
    "ca_fsa": {
      "deprecated": true,
      "type": "boolean"
    },
    "ca_full": {
      "deprecated": true,
      "type": "boolean"
    },
    "ch_plz": {
      "deprecated": true,
      "type": "boolean"
    },
    "de_plz": {
      "deprecated": true,
      "type": "boolean"
    },
    "fr_code_postal": {
      "deprecated": true,
      "type": "boolean"
    },
    "gb_full": {
      "deprecated": true,
      "type": "boolean"
    },
    "gb_outward": {
      "deprecated": true,
      "type": "boolean"
    },
    "us_zip": {
      "deprecated": true,
      "type": "boolean"
    },
    "us_zip_plus_four": {
      "deprecated": true,
      "type": "boolean"
    }
  },
  "propertyNames": {
    "anyOf": [
      {
        "pattern": "^[A-Z]{2}$"
      },
      {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "deprecated": true,
        "description": "Deprecated country-fused postal code systems for geographic targeting. Prefer postal-system with an explicit ISO 3166-1 alpha-2 country on postal area objects.",
        "enum": [
          "us_zip",
          "us_zip_plus_four",
          "gb_outward",
          "gb_full",
          "ca_fsa",
          "ca_full",
          "de_plz",
          "fr_code_postal",
          "au_postcode",
          "ch_plz",
          "at_plz"
        ],
        "title": "Country-Fused Postal Code System",
        "type": "string"
      }
    ]
  },
  "title": "Postal Area Support",
  "type": "object"
}
