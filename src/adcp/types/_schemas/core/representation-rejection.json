{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "Structured incompatibility reason for one candidate in a failed CreativeRepresentationSet resolution.",
  "properties": {
    "code": {
      "enum": [
        "incompatible_format_kind",
        "format_option_mismatch",
        "unsupported_delivery_type",
        "vast_version_mismatch",
        "macro_unsupported",
        "tracker_contract_mismatch",
        "asset_requirement_failed",
        "other"
      ],
      "type": "string"
    },
    "details": {
      "additionalProperties": true,
      "type": "object"
    },
    "message": {
      "minLength": 1,
      "type": "string"
    },
    "representation_id": {
      "minLength": 1,
      "type": "string",
      "x-entity": "creative_representation"
    }
  },
  "required": [
    "representation_id",
    "code",
    "message"
  ],
  "title": "Representation Rejection",
  "type": "object"
}
