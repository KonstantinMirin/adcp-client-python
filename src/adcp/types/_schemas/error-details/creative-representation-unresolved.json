{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "Required details shape for CREATIVE_REPRESENTATION_UNRESOLVED. Carries one structured incompatibility reason for every candidate retained in the CreativeRepresentationSet.",
  "properties": {
    "representation_rejections": {
      "items": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": true,
        "description": "Structured incompatibility reason for one candidate in a failed CreativeRepresentationSet resolution.",
        "properties": {
          "code": {
            "enum": [
              "incompatible_format_kind",
              "format_option_mismatch",
              "unsupported_delivery_type",
              "vast_version_mismatch",
              "macro_unsupported",
              "tracker_contract_mismatch",
              "asset_requirement_failed",
              "other"
            ],
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "type": "object"
          },
          "message": {
            "minLength": 1,
            "type": "string"
          },
          "representation_id": {
            "minLength": 1,
            "type": "string",
            "x-entity": "creative_representation"
          }
        },
        "required": [
          "representation_id",
          "code",
          "message"
        ],
        "title": "Representation Rejection",
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "x-adcp-validation": {
        "unique_item_properties": [
          "representation_id"
        ]
      }
    }
  },
  "required": [
    "representation_rejections"
  ],
  "title": "Creative Representation Unresolved Details",
  "type": "object",
  "x-adcp-validation": {
    "spec": "docs/creative/representation-sets.mdx#resolution-failure",
    "verifier_constraints": {
      "exact_candidate_coverage": "representation_rejections MUST contain exactly one entry for every candidate representation_id in the unresolved CreativeRepresentationSet: no missing, duplicate, or unknown representation_id values"
    }
  }
}
