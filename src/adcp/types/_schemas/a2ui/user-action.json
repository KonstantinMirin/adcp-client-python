{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "User interaction event sent from client to agent",
  "properties": {
    "action": {
      "additionalProperties": true,
      "description": "The action that was triggered",
      "properties": {
        "context": {
          "additionalProperties": true,
          "description": "Context data resolved from data model bindings",
          "type": "object"
        },
        "name": {
          "description": "Action identifier (e.g., 'view_product', 'add_to_cart')",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "componentId": {
      "description": "ID of the component that triggered the action",
      "type": "string"
    },
    "surfaceId": {
      "description": "ID of the surface where the action occurred",
      "type": "string"
    },
    "timestamp": {
      "description": "When the action occurred",
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "surfaceId",
    "componentId",
    "action"
  ],
  "title": "A2UI User Action",
  "type": "object"
}
