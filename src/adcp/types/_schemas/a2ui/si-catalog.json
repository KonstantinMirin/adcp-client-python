{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AppHandoff": {
      "description": "Platform app handoff (SI-specific)",
      "properties": {
        "apps": {
          "additionalProperties": {
            "properties": {
              "appId": {
                "type": "string"
              },
              "deepLink": {
                "type": "string"
              },
              "url": {
                "format": "uri",
                "type": "string"
              }
            },
            "type": "object"
          },
          "description": "Platform-specific app configurations",
          "type": "object"
        }
      },
      "required": [
        "apps"
      ],
      "type": "object"
    },
    "Button": {
      "description": "Interactive button component",
      "properties": {
        "action": {
          "description": "Action to trigger on click",
          "properties": {
            "context": {
              "additionalProperties": {
                "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json"
              },
              "description": "Context data to include with action",
              "type": "object"
            },
            "name": {
              "description": "Action identifier",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        "disabled": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json"
        },
        "label": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "Button label text"
        },
        "variant": {
          "default": "primary",
          "enum": [
            "primary",
            "secondary",
            "text"
          ],
          "type": "string"
        }
      },
      "required": [
        "label",
        "action"
      ],
      "type": "object"
    },
    "Card": {
      "description": "Card container for grouped content",
      "properties": {
        "action": {
          "description": "Action to trigger on card click",
          "properties": {
            "context": {
              "additionalProperties": {
                "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json"
              },
              "type": "object"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        "badge": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "Badge text (e.g., 'New', 'Sale')"
        },
        "children": {
          "description": "Child component IDs",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "image": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "Card image URL"
        },
        "subtitle": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "Card subtitle"
        },
        "title": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "Card title"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "Column": {
      "description": "Vertical layout container",
      "properties": {
        "align": {
          "default": "stretch",
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ],
          "type": "string"
        },
        "children": {
          "description": "Child component IDs",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "gap": {
          "default": "8px",
          "description": "Gap between children",
          "type": "string"
        }
      },
      "required": [
        "children"
      ],
      "type": "object"
    },
    "Image": {
      "description": "Image display component",
      "properties": {
        "alt": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "Alt text for accessibility"
        },
        "height": {
          "description": "Image height in pixels",
          "type": "integer"
        },
        "src": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "Image source URL"
        },
        "width": {
          "description": "Image width in pixels",
          "type": "integer"
        }
      },
      "required": [
        "src",
        "alt"
      ],
      "type": "object"
    },
    "IntegrationAction": {
      "description": "MCP/A2A integration action button (SI-specific)",
      "properties": {
        "highlighted": {
          "default": false,
          "description": "Visually emphasize this action",
          "type": "boolean"
        },
        "label": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "Button label"
        },
        "type": {
          "description": "Integration type",
          "enum": [
            "mcp",
            "a2a"
          ],
          "type": "string"
        },
        "url": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "Integration endpoint URL"
        }
      },
      "required": [
        "type",
        "label"
      ],
      "type": "object"
    },
    "Link": {
      "description": "Hyperlink component",
      "properties": {
        "external": {
          "default": true,
          "description": "Opens in new tab if true",
          "type": "boolean"
        },
        "label": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "Link text"
        },
        "url": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "URL to navigate to"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "type": "object"
    },
    "List": {
      "description": "Data-bound list component",
      "properties": {
        "emptyMessage": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "Message to show when list is empty"
        },
        "items": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "Path to array in data model"
        },
        "layout": {
          "default": "vertical",
          "enum": [
            "vertical",
            "horizontal",
            "grid"
          ],
          "type": "string"
        },
        "template": {
          "description": "Template for list items",
          "properties": {
            "componentId": {
              "description": "ID of component to use as template",
              "type": "string"
            }
          },
          "required": [
            "componentId"
          ],
          "type": "object"
        }
      },
      "required": [
        "items",
        "template"
      ],
      "type": "object"
    },
    "ProductCard": {
      "description": "Product display card (SI-specific)",
      "properties": {
        "action": {
          "properties": {
            "context": {
              "additionalProperties": {
                "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json"
              },
              "type": "object"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        "badge": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "Badge text (e.g., 'Best Seller')"
        },
        "ctaLabel": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "CTA button label"
        },
        "description": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "Product description"
        },
        "image": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "Product image URL"
        },
        "price": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "Price display string"
        },
        "title": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "Product name"
        }
      },
      "required": [
        "title",
        "price"
      ],
      "type": "object"
    },
    "Row": {
      "description": "Horizontal layout container",
      "properties": {
        "align": {
          "default": "center",
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ],
          "type": "string"
        },
        "children": {
          "description": "Child component IDs",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "gap": {
          "default": "8px",
          "description": "Gap between children",
          "type": "string"
        },
        "justify": {
          "default": "start",
          "enum": [
            "start",
            "center",
            "end",
            "between",
            "around"
          ],
          "type": "string"
        }
      },
      "required": [
        "children"
      ],
      "type": "object"
    },
    "Text": {
      "description": "Text display component",
      "properties": {
        "text": {
          "$ref": "https://adcontextprotocol.org/schemas/3.2.4/a2ui/bound-value.json",
          "description": "Text content to display"
        },
        "variant": {
          "default": "body",
          "enum": [
            "body",
            "heading",
            "caption",
            "label"
          ],
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    }
  },
  "description": "A2UI component catalog for Sponsored Intelligence",
  "properties": {
    "catalogId": {
      "const": "si-standard",
      "description": "SI standard component catalog",
      "type": "string"
    },
    "components": {
      "description": "Available component types",
      "items": {
        "enum": [
          "Text",
          "Button",
          "Link",
          "Image",
          "Card",
          "ProductCard",
          "List",
          "Row",
          "Column",
          "IntegrationAction",
          "AppHandoff"
        ],
        "type": "string"
      },
      "type": "array"
    }
  },
  "title": "SI Component Catalog",
  "type": "object"
}
