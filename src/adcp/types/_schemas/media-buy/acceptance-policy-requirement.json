{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "A typed prerequisite or restriction attached to a conditional seller-acceptance rule. The kind is coarse and machine-actionable; exact obligations remain in the referenced registry policies.",
  "discriminator": {
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "declaration": {
          "minLength": 1,
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "category_declaration",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "advertiser_verification",
          "type": "string"
        },
        "verification_scheme": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "description": "Stable criteria such as domestic_entity, citizen_or_resident, official_election_authority, or eligible_agency.",
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "advertiser_eligibility",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "criteria"
      ]
    },
    {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "description": "Stable restrictions such as no_foreign_funding or sponsor_identity_required.",
          "items": {
            "pattern": "^[a-z][a-z0-9_.:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "funding_restriction",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "criteria"
      ]
    },
    {
      "additionalProperties": false,
      "properties": {
        "credential": {
          "minLength": 1,
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "certification",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "additionalProperties": false,
      "properties": {
        "credential": {
          "minLength": 1,
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "license",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "prior_authorization",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "account_setup",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "sales_assisted",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "format": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "disclosure",
          "type": "string"
        },
        "placement": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "targeting_restriction",
          "type": "string"
        },
        "restricted_attributes": {
          "items": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "description": "Personal data categories that may be restricted from use in audience targeting. Combines GDPR Article 9 special categories with US civil-rights protected classes (FHA familial_status, ADEA age). Used in two places: (1) on campaign plans via restricted_attributes to declare which categories are prohibited, and (2) on signal-definition.json via restricted_attributes to declare which categories a signal touches. Governance agents match plan restrictions against signal declarations for structural validation.",
            "enum": [
              "racial_ethnic_origin",
              "political_opinions",
              "religious_beliefs",
              "trade_union_membership",
              "health_data",
              "sex_life_sexual_orientation",
              "genetic_data",
              "biometric_data",
              "age",
              "familial_status"
            ],
            "enumDescriptions": {
              "age": "A person's age or age range. US ADEA (40+) for employment, US FHA for housing, EU AVMSD for content-directed targeting. Restricted for regulated verticals.",
              "biometric_data": "Biometric data used for identification. GDPR Article 9(1).",
              "familial_status": "Whether a household includes children under 18, a pregnant person, or a person seeking custody of a minor. US FHA protected class.",
              "genetic_data": "Genetic data. GDPR Article 9(1), US GINA.",
              "health_data": "Health status, medical conditions, disability. GDPR Article 9(1), US ADA protected class. Includes inferred health data from behavioral signals.",
              "political_opinions": "Political opinions or affiliations. GDPR Article 9(1). EU DSA Article 26 prohibits targeting on this category.",
              "racial_ethnic_origin": "Race or ethnic origin. GDPR Article 9(1), US FHA/ECOA/EEOC protected class.",
              "religious_beliefs": "Religious or philosophical beliefs. GDPR Article 9(1), US FHA/EEOC protected class.",
              "sex_life_sexual_orientation": "Sex life or sexual orientation. GDPR Article 9(1).",
              "trade_union_membership": "Trade union membership. GDPR Article 9(1)."
            },
            "title": "Restricted Attribute",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "creative_restriction",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "description"
      ]
    },
    {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "destination_restriction",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "description"
      ]
    },
    {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "format_ids": {
          "deprecated": true,
          "description": "Deprecated in AdCP 3.2 and removed in AdCP 4.0. This named-format restriction is retained for 3.x compatibility; new policies identify canonical format options in description or an extension until a registry-stable format-option identity is standardized.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true,
          "x-deprecated-in": "3.2.0",
          "x-removed-in": "4.0.0"
        },
        "kind": {
          "const": "format_restriction",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "ends_at": {
          "format": "date-time",
          "type": "string"
        },
        "kind": {
          "const": "time_restriction",
          "type": "string"
        },
        "starts_at": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "const": "transparency_reporting",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "ext": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "additionalProperties": true,
          "description": "Extension object for platform-specific, vendor-namespaced parameters. Extensions are always optional and must be namespaced under a vendor/platform key (e.g., ext.gam, ext.roku). Used for custom capabilities, partner-specific configuration, and features being proposed for standardization.",
          "title": "Extension Object",
          "type": "object"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.:-]*$",
          "type": "string"
        },
        "kind": {
          "const": "custom",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "description"
      ]
    }
  ],
  "title": "Acceptance Policy Requirement",
  "type": "object"
}
